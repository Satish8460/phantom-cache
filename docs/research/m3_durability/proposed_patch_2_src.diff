+    #[tokio::test]
+    async fn replay_is_idempotent_and_bounded() {
+        let d = tmpdir("bound");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        // 3000 distinct keys in ONE tenant: must collapse to a tenant debt (ledger bound is 1024)
+        for i in 0..3000 {
+            log.append_intent(InvalidationScope::ExactKey, &format!("__default__:/many{i}"), &[2]).await.unwrap();
+        }
+        // plus duplicates of one key in another tenant
+        for _ in 0..50 {
+            log.append_intent(InvalidationScope::ExactKey, "t1:/dup", &[2]).await.unwrap();
+        }
+        log.close(false);
+        let (l1, r1) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert!(r1.debts.len() <= REPAIR_MAX_ENTRIES_PER_PEER + 1, "len {}", r1.debts.len());
+        assert!(r1.debts.iter().any(|d| d.scope == InvalidationScope::Tenant && d.key == "__default__"), "{:?}", r1.debts.len());
+        assert_eq!(r1.debts.iter().filter(|d| d.key == "t1:/dup").count(), 1);
+        l1.close(false);
+        // replaying twice yields the same debts (idempotent)
+        let (l2, r2) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        let mut a: Vec<_> = r1.debts.iter().map(|d| (d.peer, d.scope.to_u8(), d.key.clone())).collect();
+        let mut b: Vec<_> = r2.debts.iter().map(|d| (d.peer, d.scope.to_u8(), d.key.clone())).collect();
+        a.sort();
+        b.sort();
+        assert_eq!(a, b);
+        l2.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
