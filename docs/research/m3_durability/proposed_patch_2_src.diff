+    #[tokio::test]
+    async fn mid_file_corruption_falls_back_to_full_flush_for_every_peer() {
+        let d = tmpdir("corrupt");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        for i in 0..5 {
+            log.append_intent(InvalidationScope::ExactKey, &format!("__default__:/c{i}"), &[2, 3]).await.unwrap();
+        }
+        log.close(false);
+        let mut bytes = std::fs::read(&p).unwrap();
+        bytes[HEADER_LEN + 12] ^= 0x55; // inside the first record
+        std::fs::write(&p, &bytes).unwrap();
+        let (log, rep) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        assert!(matches!(rep.outcome, ReplayOutcome::CorruptFallbackFlush(_)), "{:?}", rep.outcome);
+        let mut peers: Vec<u8> = rep.debts.iter().map(|d| d.peer).collect();
+        peers.sort();
+        assert_eq!(peers, vec![2, 3]);
+        assert!(rep.debts.iter().all(|d| d.scope == InvalidationScope::FullCache));
+        assert!(corrupt_path(&p).exists(), "corrupt log must be preserved for forensics");
+        log.close(false);
+        // the fallback flush markers are themselves durable until acknowledged
+        let (log, rep) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        assert_eq!(rep.debts.len(), 2);
+        let hw = log.high_water();
+        log.ack(2, InvalidationScope::FullCache, "", hw);
+        log.close(false);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        assert_eq!(rep.debts.len(), 1);
+        assert_eq!(rep.debts[0].peer, 3);
+        let _ = std::fs::remove_dir_all(&d);
+    }
