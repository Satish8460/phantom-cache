+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tmpdir(tag: &str) -> PathBuf {
+        let d = std::env::temp_dir().join(format!("pcil_{}_{}_{}", tag, std::process::id(), rand::random::<u32>()));
+        std::fs::create_dir_all(&d).unwrap();
+        d
+    }
+
+    fn cfg() -> LogConfig {
+        LogConfig::default()
+    }
+
+    const K1: &str = "__default__:/a";
+    const K2: &str = "__default__:/b";
+
+    #[tokio::test]
+    async fn round_trip_with_acks_flush_markers_and_clean_marker() {
+        let d = tmpdir("rt");
+        let p = d.join("inval.log");
+        let (log, rep) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        assert_eq!(rep.outcome, ReplayOutcome::Fresh);
+        assert!(rep.debts.is_empty());
+        let s1 = log.append_intent(InvalidationScope::ExactKey, K1, &[2, 3]).await.unwrap();
+        let _s2 = log.append_intent(InvalidationScope::ExactKey, K2, &[2]).await.unwrap();
+        // peer 3 acknowledged K1; peer 2 did not
+        log.ack(3, InvalidationScope::ExactKey, K1, s1);
+        // peer 3 owes a full flush
+        log.append_intent(InvalidationScope::FullCache, "", &[3]).await.unwrap();
+        log.close(false);
+
+        let (log2, rep2) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        assert_eq!(rep2.outcome, ReplayOutcome::Replayed);
+        let mut got: Vec<_> = rep2.debts.iter().map(|d| (d.peer, d.scope, d.key.clone())).collect();
+        got.sort_by_key(|(p, s, k)| (*p, s.to_u8(), k.clone()));
+        assert_eq!(
+            got,
+            vec![
+                (2, InvalidationScope::ExactKey, K1.to_string()),
+                (2, InvalidationScope::ExactKey, K2.to_string()),
+                (3, InvalidationScope::FullCache, String::new()),
+            ]
+        );
+        assert!(!rep2.last_was_clean);
+        // a clean close is reported
+        log2.close(true);
+        let (log3, rep3) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        assert!(rep3.last_was_clean);
+        log3.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[tokio::test]
+    async fn newer_intent_survives_an_ack_that_started_before_it() {
+        let d = tmpdir("stamp");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        let s1 = log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await.unwrap();
+        // second DELETE of the same key arrives while the first delivery (started at s1) is in flight
+        let _s2 = log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await.unwrap();
+        log.ack(2, InvalidationScope::ExactKey, K1, s1);
+        log.close(false);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert_eq!(rep.debts.len(), 1, "the later intent must remain owed: {:?}", rep.debts);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[tokio::test]
+    async fn fully_acked_log_compacts_to_empty_on_close() {
+        let d = tmpdir("empty");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        for i in 0..50 {
+            let k = format!("__default__:/k{i}");
+            let s = log.append_intent(InvalidationScope::ExactKey, &k, &[2]).await.unwrap();
+            log.ack(2, InvalidationScope::ExactKey, &k, s);
+        }
+        let before = std::fs::metadata(&p).unwrap().len();
+        log.close(true);
+        let after = std::fs::metadata(&p).unwrap().len();
+        assert!(after < before, "compaction on close should shrink the file ({before} -> {after})");
+        let (_l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert!(rep.debts.is_empty());
+        let _ = std::fs::remove_dir_all(&d);
+    }
