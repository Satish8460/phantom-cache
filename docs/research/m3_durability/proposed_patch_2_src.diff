+    #[tokio::test]
+    async fn live_ledger_round_trip_including_inflight_complete_and_flush_marker() {
+        use crate::dist::router::RepairLedger;
+        let d = tmpdir("ledger");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        let ledger = Arc::new(RepairLedger::new());
+        assert!(ledger.attach_durable(log.clone()));
+        ledger.record(2, None, InvalidationScope::ExactKey, K1);
+        ledger.record(3, None, InvalidationScope::ExactKey, K1);
+        ledger.record(2, None, InvalidationScope::ExactKey, K2);
+        log.barrier().await;
+        // delivery of peer 2's entries starts (in flight), the first one is acknowledged
+        let batch = ledger.peek_batch(2, 10);
+        assert_eq!(batch.len(), 2);
+        assert!(batch.iter().all(|e| e.in_flight && e.durable_w >= 3));
+        ledger.complete(2, &batch[0]);
+        // peer 3 is escalated to a full flush; the flush is taken (in flight) and acknowledged
+        ledger.mark_full_flush(3);
+        log.barrier().await;
+        assert!(ledger.take_full_flush(3));
+        ledger.flush_finished(3);
+        log.barrier().await;
+        log.close(false);
+
+        let (_l, rep) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        let got: Vec<_> = rep.debts.iter().map(|d| (d.peer, d.scope, d.key.clone())).collect();
+        assert_eq!(
+            got,
+            vec![(2, InvalidationScope::ExactKey, K2.to_string())],
+            "only the unacknowledged, in-flight entry may remain owed after replay"
+        );
+        let _ = std::fs::remove_dir_all(&d);
+    }
