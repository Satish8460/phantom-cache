+// ---------------------------------------------------------------------------
+// Configuration, public types
+// ---------------------------------------------------------------------------
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FsyncPolicy {
+    /// Group commit: an intent is acknowledged to its caller only after the batch containing it was
+    /// fsync'ed. Survives power loss.
+    Always,
+    /// Writes reach the OS before the caller is released; fsync at most every `n` ms. Survives a
+    /// process crash; power loss may lose up to `n` ms of intents.
+    Interval(Duration),
+    /// Never fsync. Survives a process crash (data is in the OS page cache), not an OS crash.
+    Never,
+}
+
+impl FsyncPolicy {
+    pub fn parse(s: &str) -> Option<Self> {
+        match s {
+            "always" => Some(Self::Always),
+            "interval" => Some(Self::Interval(Duration::from_millis(100))),
+            "never" => Some(Self::Never),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct LogConfig {
+    pub fsync: FsyncPolicy,
+    /// Compaction is considered once the file exceeds this many bytes.
+    pub compact_min_bytes: u64,
+    /// Hard cap of the file size; exceeding it forces a compaction, and failing that, degrades.
+    pub max_file_bytes: u64,
+    /// Debts older than this are dropped at replay/compaction (safety net for debts whose ack can
+    /// never arrive because the live ledger collapsed differently). 0 disables the age-out.
+    pub max_debt_age_ms: u64,
+}
+
+impl Default for LogConfig {
+    fn default() -> Self {
+        Self {
+            fsync: FsyncPolicy::Always,
+            compact_min_bytes: 1 << 20,
+            max_file_bytes: 64 << 20,
+            max_debt_age_ms: 7 * 24 * 3600 * 1000,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Debt {
+    pub peer: u8,
+    pub scope: InvalidationScope,
+    /// Canonical key (ExactKey), tenant id (Tenant) or "" (FullCache).
+    pub key: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReplayOutcome {
+    /// No log existed (first start).
+    Fresh,
+    /// Log replayed completely.
+    Replayed,
+    /// Replayed; an incomplete/garbled LAST record was discarded (crash during append).
+    TornTailDiscarded { dropped_bytes: u64 },
+    /// Header or a mid-file record failed validation: the log was set aside as `<path>.corrupt` and
+    /// every peer was marked as owing a full flush.
+    CorruptFallbackFlush(String),
+    /// The log file was missing although its sentinel exists (log deleted/lost): full-flush fallback.
+    LostFallbackFlush,
+}
+
+#[derive(Debug, Clone)]
+pub struct ReplayReport {
+    pub outcome: ReplayOutcome,
+    pub records: usize,
+    pub debts: Vec<Debt>,
+    pub aged_out: usize,
+    pub last_was_clean: bool,
+}
+
+#[derive(Default)]
+pub struct LogStats {
+    pub intents: AtomicU64,
+    pub acks: AtomicU64,
+    pub fsyncs: AtomicU64,
+    pub compactions: AtomicU64,
+    pub write_errors: AtomicU64,
+    pub dropped_acks: AtomicU64,
+    pub file_bytes: AtomicU64,
+    /// Set after an unrecoverable write error: new intents are no longer durable (fail-open).
+    pub degraded: AtomicBool,
