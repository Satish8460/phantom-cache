+    #[tokio::test]
+    async fn file_size_stays_bounded_under_churn_via_compaction() {
+        let d = tmpdir("churn");
+        let p = d.join("inval.log");
+        let mut c = cfg();
+        c.compact_min_bytes = 16 * 1024;
+        c.fsync = FsyncPolicy::Never;
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        for i in 0..4000 {
+            let k = format!("__default__:/churn{i}");
+            let s = log.append_intent(InvalidationScope::ExactKey, &k, &[2]).await.unwrap();
+            log.ack(2, InvalidationScope::ExactKey, &k, s);
+        }
+        let hw = log.high_water();
+        assert!(hw >= 4000);
+        log.close(false);
+        let len = std::fs::metadata(&p).unwrap().len();
+        // uncompacted this would be 4000 * (intent ~70 B + ack ~65 B) = ~540 KB
+        assert!(len < 128 * 1024, "log not compacted: {len} bytes");
+        assert!(log.stats.compactions.load(Ordering::Relaxed) >= 1);
+        let _ = std::fs::remove_dir_all(&d);
+    }
