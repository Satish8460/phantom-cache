+        std::thread::sleep(Duration::from_millis(300));
+        log.close(false);
+        let n = successor.join().unwrap().expect("the successor must obtain the lock after the predecessor closed");
+        assert_eq!(n, 1);
+        let _ = std::fs::remove_dir_all(&d);
+    }
