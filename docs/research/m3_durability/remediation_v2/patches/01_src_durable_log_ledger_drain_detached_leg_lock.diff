+    /// Writes a log file holding one Intent (timestamp `ms`) for the given peers.
+    fn write_log_with_intent(p: &Path, ms: u64, peers: &[u8]) {
+        let mut out = header_bytes(1);
+        enc_checkpoint(1, &mut out);
+        enc_intent(1, ms, InvalidationScope::ExactKey, K1, peers, &mut out);
+        std::fs::write(p, out).unwrap();
+        std::fs::write(sentinel_path(p), b"s").unwrap();
+    }
+
+    /// Finding 5 (partial `write_all` leaves garbage mid-file).
+    /// Falsifies: "after a failed, partially written append, later appends stay readable and the
+    /// next boot replays normally instead of treating the file as corrupt (full flush of every peer)".
+    #[tokio::test]
+    async fn partial_write_failure_does_not_leave_garbage_mid_file() {
+        let d = tmpdir("pw");
+        let p = d.join("inval.log");
+        let (c, hooks) = hooked_cfg();
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        hooks.partial_write.store(true, Ordering::Relaxed);
+        hooks.fail_writes.store(1, Ordering::SeqCst);
+        let _r1 = log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await;
+        let r2 = log.append_intent(InvalidationScope::ExactKey, K2, &[2]).await;
+        assert!(r2.is_ok(), "the log must recover after one failed write");
+        assert_eq!(log.stats.rotations.load(Ordering::Relaxed), 1, "exactly one rewrite must have recovered the log");
+        assert!(!log.stats.degraded.load(Ordering::Relaxed));
+        log.close(false);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
