+// ---------------------------------------------------------------------------
+// Configuration, public types
+// ---------------------------------------------------------------------------
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FsyncPolicy {
+    /// Group commit: an intent is acknowledged to its caller only after the batch containing it was
+    /// fsync'ed. Survives power loss.
+    Always,
+    /// Writes reach the OS before the caller is released; fsync at most every `n` ms. Survives a
+    /// process crash; power loss may lose up to `n` ms of intents.
+    Interval(Duration),
+    /// Never fsync. Survives a process crash (data is in the OS page cache), not an OS crash.
+    Never,
+}
+
+impl FsyncPolicy {
+    pub fn parse(s: &str) -> Option<Self> {
+        match s {
+            "always" => Some(Self::Always),
+            "interval" => Some(Self::Interval(Duration::from_millis(100))),
+            "never" => Some(Self::Never),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct LogConfig {
+    pub fsync: FsyncPolicy,
+    /// Compaction is considered once the file exceeds this many bytes.
+    pub compact_min_bytes: u64,
+    /// Hard cap of the file size; exceeding it forces a compaction, and failing that, degrades.
+    pub max_file_bytes: u64,
+    /// Debts older than this are dropped at replay/compaction (safety net for debts whose ack can
+    /// never arrive because the live ledger collapsed differently). 0 disables the age-out.
+    pub max_debt_age_ms: u64,
+    /// Upper bound on how long `append_intent` waits for the writer thread to make an intent durable
+    /// (queue wait + write + fsync). On expiry the DELETE proceeds fail-open and the miss is counted
+    /// (`LogStats::not_durable` / `wait_timeouts`) and reported on stderr. PROPOSAL default 2000 ms
+    /// (`PHANTOM_INVALIDATION_LOG_WAIT_MS`); the owner decides the fail-open vs fail-closed policy (D1).
+    pub durability_wait: Duration,
+    /// How long `open` keeps retrying the single-writer lock before failing (covers the overlap of an
+    /// old process that is still draining with its supervised replacement).
+    pub lock_wait: Duration,
+    /// First delay before a failed compaction is retried; doubles per consecutive failure up to
+    /// `COMPACT_RETRY_MAX`. Keeps a persistently failing compaction from retrying (and logging) every tick.
+    pub compact_retry_initial: Duration,
+    /// Fault injection for unit tests only (None in every production configuration).
+    pub hooks: Option<Arc<Hooks>>,
+}
+
+/// Fault-injection switches consulted by the writer thread (tests only; see `LogConfig::hooks`).
+#[derive(Default)]
+pub struct Hooks {
+    /// Number of upcoming batch writes that fail with an I/O error.
+    pub fail_writes: std::sync::atomic::AtomicU32,
+    /// When set, a failing write first writes the first half of the batch (a partial write).
+    pub partial_write: AtomicBool,
+    /// Number of upcoming `sync_data` calls that fail.
+    pub fail_syncs: std::sync::atomic::AtomicU32,
+    /// Milliseconds the writer sleeps before handling each batch (simulates a slow disk).
+    pub stall_ms: AtomicU64,
+}
+
+impl std::fmt::Debug for Hooks {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
