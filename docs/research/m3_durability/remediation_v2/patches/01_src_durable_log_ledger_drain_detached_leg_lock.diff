+
+    /// F-03. Falsifies: "a stalled writer (hung fsync, dead disk) makes `append_intent` wait for as
+    /// long as the stall lasts". Required: the wait is bounded by `durability_wait`, the caller gets
+    /// `Err` (fail-open), and the miss is counted as `wait_timeouts` and `not_durable`.
+    #[tokio::test]
+    async fn f03_stalled_writer_bounds_the_durability_wait() {
+        let d = tmpdir("f03");
+        let p = d.join("inval.log");
+        let (mut c, hooks) = hooked_cfg();
+        c.durability_wait = Duration::from_millis(250);
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        hooks.stall_ms.store(1500, Ordering::Relaxed);
+        let t = Instant::now();
+        let r = log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await;
+        let waited = t.elapsed();
+        assert!(r.is_err(), "a stalled writer must surface as Err (fail-open), got {r:?}");
+        assert!(waited < Duration::from_millis(1200), "the wait must end near durability_wait (250 ms), not at the end of the stall: {waited:?}");
+        assert!(waited >= Duration::from_millis(200), "the wait must not give up before durability_wait: {waited:?}");
+        assert_eq!(log.stats.wait_timeouts.load(Ordering::Relaxed), 1);
+        assert_eq!(log.stats.not_durable.load(Ordering::Relaxed), 1);
+        // the writer finishes the stalled batch afterwards; the log stays usable
+        hooks.stall_ms.store(0, Ordering::Relaxed);
+        log.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// F-04 (unit-level write-before-ack ordering). Falsifies: "`append_intent` can return before the
+    /// intent is in the file (and, under fsync=always, fsynced)". With the writer stalled for 400 ms:
+    /// (1) the future is still pending after 100 ms, (2) when it resolves the intent is READABLE FROM
+    /// THE FILE and at least one fsync was counted. Removing the wait on the writer fails all three.
+    #[tokio::test]
+    async fn f04_append_intent_resolves_only_after_the_intent_is_in_the_file() {
+        let d = tmpdir("f04");
+        let p = d.join("inval.log");
+        let (mut c, hooks) = hooked_cfg();
+        c.durability_wait = Duration::from_secs(10);
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        hooks.stall_ms.store(400, Ordering::Relaxed);
+        let fut = log.append_intent(InvalidationScope::ExactKey, K1, &[2]);
+        tokio::pin!(fut);
+        let early = tokio::time::timeout(Duration::from_millis(100), &mut fut).await;
+        assert!(early.is_err(), "append_intent resolved at 100 ms although the writer was stalled for 400 ms: the 204 could precede the write");
+        let stamp = fut.await.expect("the intent must become durable once the stall ends");
+        let bytes = std::fs::read(&p).unwrap();
+        let parsed = parse(&bytes, 1).expect("log parses");
+        assert!(
+            parsed.state.debts().iter().any(|d| d.peer == 2 && d.key == K1),
+            "append_intent returned Ok(stamp={stamp}) but the intent is not in the file"
+        );
+        assert!(log.stats.fsyncs.load(Ordering::Relaxed) >= 1, "fsync=always: the caller was released before any fsync");
+        hooks.stall_ms.store(0, Ordering::Relaxed);
+        log.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// F-07. Falsifies: "two processes (here: two handles) can own the same log". The second open
+    /// must fail with a clear error and must NOT touch the file; after the first closes, it succeeds.
+    #[tokio::test]
+    async fn f07_second_open_of_the_same_log_is_refused_with_a_clear_error() {
+        let d = tmpdir("f07");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await.unwrap();
+        let before = std::fs::read(&p).unwrap();
+        let quick = LogConfig { lock_wait: Duration::from_millis(100), ..cfg() };
+        let t = Instant::now();
+        let err = match DurableLog::open(&p, 1, &[2], quick) {
+            Ok(_) => panic!("a second owner of the same log was accepted"),
+            Err(e) => e,
+        };
+        assert!(t.elapsed() < Duration::from_secs(2), "the refusal must be prompt");
+        assert_eq!(err.kind(), std::io::ErrorKind::WouldBlock, "{err}");
+        let msg = err.to_string();
+        assert!(msg.contains("single-writer lock") && msg.contains(".lock"), "unclear error: {msg}");
+        assert_eq!(std::fs::read(&p).unwrap(), before, "the refused open must not modify the log");
+        log.close(false);
+        // once released, a new owner succeeds and sees the debt
+        let (log2, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert_eq!(rep.debts.len(), 1);
+        log2.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// F-07. A successor that starts while the predecessor is still shutting down waits for the lock
+    /// (bounded by `lock_wait`) instead of failing: the supervised-restart overlap.
+    #[tokio::test]
+    async fn f07_successor_waits_for_a_predecessor_that_is_shutting_down() {
+        let d = tmpdir("f07b");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await.unwrap();
+        let p2 = p.clone();
+        let successor = std::thread::spawn(move || {
+            let c = LogConfig { lock_wait: Duration::from_secs(5), ..LogConfig::default() };
+            DurableLog::open(&p2, 1, &[2], c).map(|(l, r)| {
+                let n = r.debts.len();
+                l.close(false);
+                n
+            })
