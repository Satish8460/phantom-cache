+// Crash-point instrumentation for the M3 test matrix. Compiled ONLY when the crate is built with
+// `RUSTFLAGS="--cfg m3_failpoints"` (a compiler flag, not a cargo feature, so Cargo.toml is not
+// touched). A plain `cargo build` / `cargo build --release` never defines that cfg, so in every
+// default and production build `failpoint` is an empty inline function and the string
+// `PHANTOM_M3_FAILPOINT` is absent from the binary. The combination `m3_failpoints` + release
+// profile is rejected at compile time (below).
+//
+// With the cfg on, a gateway whose environment names this point in `PHANTOM_M3_FAILPOINT`
+// (comma separated) terminates itself at once with exit code 137, without running any shutdown
+// path: the closest in-process equivalent of kill -9 at an exact code location.
+#[cfg(all(m3_failpoints, not(debug_assertions)))]
+compile_error!("the m3_failpoints cfg is a test-only crash injector and must never be built without debug assertions (release)");
+
+#[cfg(m3_failpoints)]
+pub fn failpoint(name: &str) {
+    if let Ok(v) = std::env::var("PHANTOM_M3_FAILPOINT") {
+        if v.split(',').any(|p| !p.is_empty() && p == name) {
+            eprintln!("[failpoint] {name}: terminating the process now (exit 137)");
+            std::process::exit(137);
+        }
+    }
+}
+#[cfg(not(m3_failpoints))]
+#[inline(always)]
+pub fn failpoint(_name: &str) {}
+
+/// Test-matrix only (cfg `m3_failpoints`): lets the crash tests force very frequent compaction.
+/// A no-op in every other build.
+#[cfg(m3_failpoints)]
+pub fn apply_test_overrides(cfg: &mut LogConfig) {
+    if let Some(n) = std::env::var("PHANTOM_M3_TEST_COMPACT_MIN_BYTES").ok().and_then(|v| v.parse::<u64>().ok()) {
+        cfg.compact_min_bytes = n;
+    }
+}
+#[cfg(not(m3_failpoints))]
+#[inline(always)]
+pub fn apply_test_overrides(_cfg: &mut LogConfig) {}
+
+fn now_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
