+    fn three_record_log(p: &Path) -> Vec<u8> {
+        let mut out = header_bytes(1);
+        enc_checkpoint(3, &mut out);
+        enc_intent(1, 10, InvalidationScope::ExactKey, K1, &[2], &mut out);
+        enc_intent(2, 11, InvalidationScope::ExactKey, K2, &[2], &mut out);
+        enc_intent(3, 12, InvalidationScope::ExactKey, "__default__:/c", &[2], &mut out);
+        std::fs::write(p, &out).unwrap();
+        std::fs::write(sentinel_path(p), b"s").unwrap();
+        out
+    }
+
+    /// F-08. Falsifies: "a corrupted length field in the middle of the file is classified as a torn
+    /// tail and every later record is silently dropped". The first intent's length is rewritten to a
+    /// value that runs past the end of the (small) file; its own fields contradict it, so the open
+    /// must take the corrupt-log fallback (full flush owed to every peer) and keep the evidence.
+    #[tokio::test]
+    async fn f08_corrupt_mid_file_length_is_corruption_not_a_torn_tail() {
+        let d = tmpdir("f08");
+        let p = d.join("inval.log");
+        let mut bytes = three_record_log(&p);
+        // header 20 | checkpoint record (4+9+4=17) | first intent record starts at 37
+        let first_intent = HEADER_LEN + 17;
+        let real = u32::from_le_bytes(bytes[first_intent..first_intent + 4].try_into().unwrap());
+        assert!(real > 10 && (real as usize) < 200);
+        bytes[first_intent..first_intent + 4].copy_from_slice(&4000u32.to_le_bytes());
+        std::fs::write(&p, &bytes).unwrap();
+        let (log, rep) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        match &rep.outcome {
+            ReplayOutcome::CorruptFallbackFlush(why) => assert!(why.contains("corrupt length field"), "unhelpful reason: {why}"),
+            other => panic!("a corrupt mid-file length was taken for {other:?}; later records would be silently lost"),
+        }
+        let mut peers: Vec<u8> = rep.debts.iter().filter(|d| d.scope == InvalidationScope::FullCache).map(|d| d.peer).collect();
+        peers.sort();
+        assert_eq!(peers, vec![2, 3], "every peer must owe a full flush");
+        assert!(corrupt_path(&p).exists(), "the corrupt log must be kept as evidence");
+        log.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// F-08 guard against false positives: every cut point of every record type, with its TRUE
+    /// length, must be accepted as a plausible torn prefix; a wrong length is contradicted as soon as
+    /// the fields that fix the length are present. (The existing torn-tail test covers the same via `open`.)
+    #[test]
+    fn f08_length_check_accepts_every_true_prefix_and_rejects_wrong_lengths() {
+        let mut recs: Vec<Vec<u8>> = Vec::new();
+        let mut r = Vec::new();
+        enc_intent(7, 99, InvalidationScope::ExactKey, K1, &[2, 3], &mut r);
+        recs.push(r);
+        let mut r = Vec::new();
+        enc_ack(2, InvalidationScope::ExactKey, K2, 5, &mut r);
+        recs.push(r);
+        let mut r = Vec::new();
+        enc_flush(2, 4, 1234, &mut r);
+        recs.push(r);
+        let mut r = Vec::new();
+        enc_checkpoint(9, &mut r);
+        recs.push(r);
+        let mut r = Vec::new();
+        enc_clean(1234, &mut r);
+        recs.push(r);
+        for r in &recs {
+            let blen = u32::from_le_bytes(r[0..4].try_into().unwrap()) as usize;
+            let body = &r[4..4 + blen];
+            for cut in 1..=body.len() {
+                assert_eq!(length_contradicts_prefix(&body[..cut], blen), None, "true length rejected at cut {cut} of type {}", body[0]);
+            }
+            // a wrong length is caught once the whole body is present
+            assert!(length_contradicts_prefix(body, blen + 1).is_some(), "length+1 not contradicted (type {})", body[0]);
+            assert!(length_contradicts_prefix(body, blen - 1).is_some(), "length-1 not contradicted (type {})", body[0]);
+        }
+        // a zero-filled (not yet persisted) tail proves nothing
+        assert_eq!(length_contradicts_prefix(&[0u8; 40], 100), None);
+        assert_eq!(length_contradicts_prefix(&[], 100), None);
+        // an impossible type byte is corruption
+        assert!(length_contradicts_prefix(&[77, 1, 2, 3], 50).is_some());
+    }
