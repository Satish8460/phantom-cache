+//! PROPOSED PATCH (investigation prototype, validated only in a scratch copy, NOT integrated).
+//!
+//! Opt-in durable owed-invalidation log (M3). Off unless `PHANTOM_INVALIDATION_LOG_PATH` is set.
+//!
+//! Purpose: an invalidation that this gateway accepted (DELETE answered 204) but that some peer has
+//! not acknowledged yet must survive a crash/restart of this gateway, so that the restarted
+//! gateway can keep delivering it. Failure model: process crash / kill -9 / SIGTERM / restart.
+//! With `fsync=always` also power loss / OS crash. Disk loss is excluded.
+//!
+//! File format (all integers little endian), version 1:
+//!   header (20 bytes): magic "PCIL" | version u16 | node_id u8 | reserved u8 | created_unix_ms u64
+//!                      | crc32 u32 (over the preceding 16 bytes)
+//!   record: body_len u32 | body | crc32 u32 (over body_len bytes and body)
+//!   body  : type u8 | payload
+//!     1 Intent      stamp u64 | unix_ms u64 | scope u8 | key_len u16 | key | npeers u8 | peers u8*npeers
+//!     2 Ack         peer u8 | scope u8 | key_len u16 | key | upto_stamp u64
+//!     3 FlushMarker peer u8 | stamp u64 | unix_ms u64      (peer owes a FullCache flush)
+//!     4 Checkpoint  stamp_counter u64                      (first record of a compacted file)
+//!     5 Clean       unix_ms u64                            (informational: orderly shutdown)
+//!
+//! The stream sequence counters and the replay ring are NOT persisted (a restarted gateway starts
+//! new streams; the receiver applies every InvalidateRequest regardless of sequence).
+//!
+//! In-memory image (`State`) mirrors the repair-ledger bounds (entries and key bytes per peer, tenant
+//! collapse, then full-flush marker). It is rebuilt from the log on boot and re-injected into the live
+//! `RepairLedger` by the caller.
+
+// The `m3_failpoints` cfg is set only by an explicit `RUSTFLAGS="--cfg m3_failpoints"` (see below), so it is
+// unknown to cargo's cfg check; silence that lint for this module only (an item-level allow does not
+// reach the cfg attribute itself).
+#![allow(unexpected_cfgs)]
+
+use crate::dist::frame::{InvalidationScope, MAX_KEY_LENGTH_BYTES};
+use crate::dist::router::{
+    tenant_of_canonical, REPAIR_MAX_ENTRIES_PER_PEER, REPAIR_MAX_KEY_BYTES_PER_PEER,
+    REPAIR_MAX_TENANT_FLUSHES_PER_PEER,
+};
+use std::collections::{BTreeMap, HashMap};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::mpsc;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+pub const MAGIC: &[u8; 4] = b"PCIL";
+pub const VERSION: u16 = 1;
+pub const HEADER_LEN: usize = 20;
+/// Largest record body accepted on replay (a 4096-byte key plus 255 peers plus fixed fields).
+pub const MAX_BODY: usize = 8192;
+const CHANNEL_CAPACITY: usize = 8192;
+
+const T_INTENT: u8 = 1;
+const T_ACK: u8 = 2;
+const T_FLUSH: u8 = 3;
+const T_CHECKPOINT: u8 = 4;
+const T_CLEAN: u8 = 5;
+
+// ---------------------------------------------------------------------------
+// CRC-32 (IEEE 802.3, reflected, poly 0xEDB88320); table built at compile time, no dependency.
+// ---------------------------------------------------------------------------
+const fn make_crc_table() -> [u32; 256] {
+    let mut table = [0u32; 256];
+    let mut i = 0;
+    while i < 256 {
+        let mut c = i as u32;
+        let mut k = 0;
+        while k < 8 {
+            c = if c & 1 != 0 { 0xEDB8_8320 ^ (c >> 1) } else { c >> 1 };
+            k += 1;
+        }
+        table[i] = c;
+        i += 1;
+    }
+    table
+}
+static CRC_TABLE: [u32; 256] = make_crc_table();
+
+pub fn crc32(parts: &[&[u8]]) -> u32 {
+    let mut c = 0xFFFF_FFFFu32;
+    for p in parts {
+        for &b in *p {
+            c = CRC_TABLE[((c ^ b as u32) & 0xFF) as usize] ^ (c >> 8);
+        }
+    }
+    !c
+}
