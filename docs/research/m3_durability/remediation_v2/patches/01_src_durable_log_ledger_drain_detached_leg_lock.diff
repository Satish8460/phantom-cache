+}
+
+impl Default for LogConfig {
+    fn default() -> Self {
+        Self {
+            fsync: FsyncPolicy::Always,
+            compact_min_bytes: 1 << 20,
+            max_file_bytes: 64 << 20,
+            max_debt_age_ms: 7 * 24 * 3600 * 1000,
+            durability_wait: Duration::from_millis(2000),
+            lock_wait: Duration::from_millis(5000),
+            compact_retry_initial: Duration::from_secs(5),
