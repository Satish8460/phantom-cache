+    fn hooked_cfg() -> (LogConfig, Arc<Hooks>) {
+        let h = Arc::new(Hooks::default());
+        let c = LogConfig { hooks: Some(h.clone()), ..LogConfig::default() };
+        (c, h)
+    }
