+//! M3 crash-point test matrix (K1-K21) for the opt-in durable invalidation log.
+//!
+//! Compiled only when the test target is built with `RUSTFLAGS="--cfg m3_failpoints"` (no cargo
+//! feature, so Cargo.toml is not edited; in a default build this file is an empty test target).
+//! Run (separate target dir, because the flag changes every crate's fingerprint):
+//! `RUSTFLAGS="--cfg m3_failpoints" CARGO_TARGET_DIR=<dir> cargo test -j 1 --test m3_crash_point_tests -- --test-threads=1 --nocapture`.
+//! The cfg compiles named crash points (`dist::router::durable_log::failpoint`) into the gateway: a
+//! gateway whose environment names a point in `PHANTOM_M3_FAILPOINT` terminates itself there with
+//! exit code 137 and no shutdown path (closest in-process equivalent of kill -9 at an exact code
+//! location). Without the cfg the points are empty functions.
+//!
+//! Every test names the property it can falsify. Method: real `phantom-cache-demo` processes, mTLS
+//! cluster, loopback, a fault proxy on every link, an origin advertising `max-age=120` (so a stale
+//! entry outlives every observation window). Scenario (3 gateways unless stated): 1 = issuer G,
+//! 2 = victim B (G->B link blackholed), 3 = canonical primary of the key (G's synchronous leg works).
+//!
+//! Results are loopback / debug build / single Windows host. Not covered here (see the matrix doc):
+//! K18 power loss, K19 Linux, K20 Windows service stop, real clock steps (K16 is a unit test).
+
+#![allow(unexpected_cfgs)]
+#![cfg(m3_failpoints)]
+
+#[path = "support/mod.rs"]
+mod support;
+
+use phantom_cache_demo::dist::node::{NodeState, VirtualNode};
+use phantom_cache_demo::dist::router::RendezvousRouter;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+use support::cluster_harness::{ClusterHarness, ClusterOptions};
+use support::fault_proxy::FaultMode;
+
+const G: u8 = 1; // issuer
+const B: u8 = 2; // victim
+const P: u8 = 3; // canonical primary
+const A: u8 = 4; // second, reachable peer (K6)
+const OBSERVE: Duration = Duration::from_secs(10);
+
+/// The tests are heavy (3-4 gateway processes each) and their observation windows are wall-clock:
+/// within this binary they run one at a time even when the harness runs tests in parallel.
+static SERIAL: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+
+/// `n` distinct paths whose canonical primary among nodes 1..=node_count is `want`.
+fn paths_with_primary(want: u8, node_count: u8, tag: &str, n: usize) -> Vec<String> {
+    let nodes: Vec<Arc<VirtualNode>> = (1..=node_count)
+        .map(|i| {
+            let v = Arc::new(VirtualNode::new(i));
+            v.set_state(NodeState::Active);
+            v
+        })
+        .collect();
+    let router = RendezvousRouter::new(nodes);
+    let mut out = Vec::new();
+    for i in 0..200_000 {
+        let path = format!("/{tag}_{i}");
+        if router.route_key(&format!("__default__:{path}")).map(|x| x.node_id) == Some(want) {
+            out.push(path);
+            if out.len() == n {
+                break;
+            }
+        }
+    }
+    router.stop();
+    assert_eq!(out.len(), n, "not enough keys with primary {want}");
+    out
+}
+
+async fn start(node_ids: &[u8], per_node: Vec<(String, String)>) -> ClusterHarness {
+    let mut env = vec![("PHANTOM_INVALIDATION_LOG_PATH".to_string(), "{dir}/inval_{id}.log".to_string())];
+    env.extend(per_node);
+    let opts = ClusterOptions {
+        with_proxies: true,
+        origin_max_age_secs: Some(120),
+        per_node_env: env,
+        startup_timeout: Duration::from_secs(25),
+        ..ClusterOptions::default()
+    };
+    let h = ClusterHarness::start_with_options(node_ids, opts).await.expect("cluster start");
+    h.warm_invalidation_paths().await.expect("warm paths");
+    h
+}
+
+fn s(k: &str, v: &str) -> (String, String) {
+    (k.to_string(), v.to_string())
+}
+
+/// Restarts the issuer with the failpoint `name` armed (and `extra` env), then warms nothing.
+async fn arm(h: &mut ClusterHarness, name: &str, extra: &[(String, String)]) {
+    // Let the warm-up DELETEs' fan-out be acknowledged and logged first; otherwise the armed
+    // restart would replay a leftover warm-up debt and could hit the failpoint during boot.
+    tokio::time::sleep(Duration::from_millis(1500)).await;
+    h.kill_node(G).await.expect("kill for arming");
+    let mut env = vec![s("PHANTOM_M3_FAILPOINT", name)];
+    env.extend(extra.iter().cloned());
+    h.restart_node(G, &env).await.expect("armed restart");
+}
+
+async fn disarm_restart(h: &mut ClusterHarness) {
+    h.restart_node(G, &[s("PHANTOM_M3_FAILPOINT", "")]).await.expect("disarmed restart");
+}
+
+async fn warm_all(h: &ClusterHarness, path: &str, nodes: &[u8]) {
+    for &n in nodes {
+        let (st, _b, _c, ver) = h.http_get(n, path).await.expect("warm get");
+        assert!(st == 200 && ver == Some(1), "warm-up GET on node {n}: {st} v{ver:?}");
+    }
+}
+
+async fn version_on(h: &ClusterHarness, node: u8, path: &str) -> Option<u64> {
+    h.http_get(node, path).await.ok().and_then(|r| r.3)
+}
+
+/// Polls `node` until it serves version 2; `None` = still stale (or unreachable) after `within`.
+async fn wait_v2(h: &ClusterHarness, node: u8, path: &str, within: Duration) -> Option<Duration> {
+    let t = Instant::now();
+    while t.elapsed() < within {
+        if let Ok((200, _b, _c, Some(2))) = h.http_get(node, path).await.map(|r| (r.0.as_u16(), r.1, r.2, r.3)) {
+            return Some(t.elapsed());
+        }
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    None
+}
+
+/// All lines of the issuer's log (all incarnations) that report a replay.
+fn replay_lines(h: &ClusterHarness) -> Vec<String> {
+    h.gateway_log_lines_containing(G, &["replay outcome"])
+}
+
+fn owed_of(line: &str) -> Option<usize> {
+    // "... replay outcome X, N records, M owed invalidation(s) re-queued, K aged out"
+    let idx = line.find(" owed invalidation")?;
+    let head = &line[..idx];
+    head.rsplit(", ").next()?.trim().parse().ok()
+}
+
+fn last_replay(h: &ClusterHarness) -> (String, usize) {
+    let l = replay_lines(h).pop().expect("no replay line in the issuer log");
+    let n = owed_of(&l).unwrap_or_else(|| panic!("cannot parse owed count from: {l}"));
+    (l, n)
+}
+
+fn log_file(h: &ClusterHarness) -> std::path::PathBuf {
+    h.pki.temp_dir.join("inval_1.log")
+}
+
+struct Crash {
+    h: ClusterHarness,
+    path: String,
+    delete_status: Option<u16>,
+    issuer_exit: Result<String, String>,
+}
+
+/// The common crash scenario: arm `fp` on the issuer, warm the key everywhere, change the origin,
+/// blackhole G->B, DELETE via G, wait for the issuer to die at the failpoint, heal and restart it
+/// WITHOUT the failpoint.
+async fn crash_at(fp: &str, tag: &str, extra: &[(String, String)]) -> Crash {
+    let mut h = start(&[G, B, P], vec![]).await;
+    arm(&mut h, fp, extra).await;
+    let path = paths_with_primary(P, 3, tag, 1).remove(0);
+    warm_all(&h, &path, &[G, B, P]).await;
