+/// Spawns one gateway process. On Windows the child gets its own process group so that a
+/// CTRL_BREAK can be aimed at it (graceful stop); everything else is identical on all platforms.
+fn spawn_gateway(
+    bin_path: &std::path::Path,
+    env: &[(String, String)],
+    log_out: std::fs::File,
+    log_err: std::fs::File,
+) -> std::io::Result<Child> {
+    let mut cmd = Command::new(bin_path);
+    cmd.kill_on_drop(true)
+        .stdout(std::process::Stdio::from(log_out))
+        .stderr(std::process::Stdio::from(log_err));
+    for (k, v) in env {
+        cmd.env(k, v);
+    }
+    #[cfg(windows)]
+    {
+        const CREATE_NEW_PROCESS_GROUP: u32 = 0x0000_0200;
+        cmd.creation_flags(CREATE_NEW_PROCESS_GROUP);
+    }
+    cmd.spawn()
+}
