+/// Windows only: sends CTRL_BREAK to the process group of `pid` (the child must have been created
+/// with CREATE_NEW_PROCESS_GROUP and the calling process must share a console with it).
+#[cfg(windows)]
+fn send_ctrl_break(pid: u32) -> Result<(), String> {
+    extern "system" {
+        fn GenerateConsoleCtrlEvent(dw_ctrl_event: u32, dw_process_group_id: u32) -> i32;
+        fn GetLastError() -> u32;
+    }
+    const CTRL_BREAK_EVENT: u32 = 1;
+    // SAFETY: plain Win32 calls with integer arguments.
+    unsafe {
+        if GenerateConsoleCtrlEvent(CTRL_BREAK_EVENT, pid) != 0 {
+            Ok(())
+        } else {
+            Err(format!("GenerateConsoleCtrlEvent failed, GetLastError={}", GetLastError()))
+        }
+    }
+}
