+//! M3 rework v2, F-06: graceful stop while a detached DELETE cluster leg is in flight.
+//! AI-written; not independently verified. Real gateway processes, loopback, one Windows host.
+//!
+//! Scenario (3 gateways, mTLS, fault proxies, origin max-age=120, durable log ON on every node):
+//! 1 = issuer G, 2 = peer B, 3 = canonical primary P of the key. The G->P link is delayed by 60 ms
+//! per direction (round trip 120 ms < the 150 ms leg timeout), so the DELETE's primary leg is in
+//! flight for >100 ms. 40 ms after the client sent the DELETE, G gets the orderly stop request
+//! (Ctrl-Break on Windows, SIGTERM on Unix). Then G is restarted and the links are normal.
+//!
+//! Properties (falsifiable): (1) NO HALF-APPLIED DELETE: if the primary serves the new version after the
+//! stop, B must also learn of the DELETE (the stop must not cancel the leg between the primary ack and
+//! the fan-out); (2) "a DELETE for which the client RECEIVED 204 is never lost by the stop":
+//! after the restart B and P must serve the new version. If the client saw no status (the process
+//! went away before answering), nothing was promised; the outcome is printed and the test records
+//! it without failing. The process must also exit by itself within 15 s (no hang) and must not
+//! leave a log that the next start treats as corrupt.
+//!
+//! `#[ignore]`: a graceful stop on Windows needs a shared console (CTRL_BREAK); run with
+//! `cargo test -j 1 --test m3_shutdown_leg_tests -- --include-ignored --nocapture`.
+
+#[path = "support/mod.rs"]
+mod support;
+
+use phantom_cache_demo::dist::node::{NodeState, VirtualNode};
+use phantom_cache_demo::dist::router::RendezvousRouter;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+use support::cluster_harness::{ClusterHarness, ClusterOptions};
+use support::fault_proxy::FaultMode;
+
+const G: u8 = 1;
+const B: u8 = 2;
+const P: u8 = 3;
+
+fn path_with_primary(want: u8, tag: &str) -> String {
+    let nodes: Vec<Arc<VirtualNode>> = (1..=3u8)
+        .map(|i| {
+            let v = Arc::new(VirtualNode::new(i));
+            v.set_state(NodeState::Active);
+            v
+        })
+        .collect();
+    let router = RendezvousRouter::new(nodes);
+    for i in 0..200_000 {
+        let path = format!("/{tag}_{i}");
+        if router.route_key(&format!("__default__:{path}")).map(|x| x.node_id) == Some(want) {
+            router.stop();
+            return path;
+        }
+    }
+    panic!("no key with primary {want}");
+}
+
+async fn version_on(h: &ClusterHarness, node: u8, path: &str) -> Option<u64> {
+    h.http_get(node, path).await.ok().and_then(|r| r.3)
+}
+
+async fn wait_v2(h: &ClusterHarness, node: u8, path: &str, within: Duration) -> Option<Duration> {
+    let t = Instant::now();
+    while t.elapsed() < within {
+        if version_on(h, node, path).await == Some(2) {
+            return Some(t.elapsed());
+        }
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    None
+}
+
+#[tokio::test]
+#[ignore = "graceful stop: needs a console on Windows (CTRL_BREAK); run with --include-ignored"]
+async fn f06_graceful_stop_with_a_delete_leg_in_flight_never_loses_an_acknowledged_delete() {
+    let opts = ClusterOptions {
+        with_proxies: true,
+        origin_max_age_secs: Some(120),
+        per_node_env: vec![("PHANTOM_INVALIDATION_LOG_PATH".to_string(), "{dir}/inval_{id}.log".to_string())],
+        startup_timeout: Duration::from_secs(25),
+        ..ClusterOptions::default()
+    };
+    let mut h = ClusterHarness::start_with_options(&[G, B, P], opts).await.expect("cluster start");
+    h.warm_invalidation_paths().await.expect("warm paths");
+    let path = path_with_primary(P, "f06");
+    for n in [G, B, P] {
+        let (st, _b, _c, ver) = h.http_get(n, &path).await.expect("warm get");
+        assert!(st == 200 && ver == Some(1), "warm-up GET on node {n}: {st} v{ver:?}");
+    }
+    // let the warm-up DELETEs' fan-out settle so only this scenario's debt exists
+    tokio::time::sleep(Duration::from_millis(1500)).await;
+    assert_eq!(h.origin().mutate_key(&path, "v2"), 2);
+    h.set_link_mode(G, P, FaultMode::Delay { ms: 60 }).await;
+
+    let url = format!("http://{}/api/v1/cache{}", h.gateways[&G].http_addr, path);
+    let client = reqwest::Client::new();
+    let delete = tokio::spawn(async move {
+        client.delete(&url).timeout(Duration::from_secs(8)).send().await.map(|r| r.status().as_u16()).map_err(|e| e.to_string())
+    });
+    tokio::time::sleep(Duration::from_millis(40)).await;
+    if let Err(e) = h.request_graceful_stop(G) {
+        eprintln!("[F06] GRACEFUL_STOP_NOT_FEASIBLE: {e}");
+        delete.abort();
+        return;
+    }
+    let client_result = delete.await.expect("client task");
+    let exit = h.wait_node_exit(G, Duration::from_secs(15)).await;
+    eprintln!("[F06] client result: {client_result:?}; issuer exit: {exit:?}");
+    assert!(exit.is_ok(), "the issuer must exit by itself within 15 s of the stop request: {exit:?}");
+    h.set_link_mode(G, P, FaultMode::Normal).await;
+    h.restart_node(G, &[]).await.expect("restart issuer");
+
+    let drain_lines = h.gateway_log_lines_containing(G, &["[shutdown] invalidation drain", "replay outcome"]);
+    for l in &drain_lines {
+        eprintln!("[F06] issuer log: {l}");
+    }
+    assert!(
+        !drain_lines.iter().any(|l| l.contains("CorruptFallbackFlush") || l.contains("LostFallbackFlush")),
+        "a stop with a leg in flight must not leave a log that the next start treats as corrupt/lost"
+    );
+
+    let p = version_on(&h, P, &path).await;
+    // Half-applied is the defect: the primary was invalidated (this DELETE took effect there) but the
+    // other member was never told and nobody was promised anything (no 204), so no retry is triggered.
+    let b = wait_v2(&h, B, &path, Duration::from_secs(10)).await;
+    eprintln!("[F06] client result {client_result:?}: primary serves v{p:?}; B converged after {b:?}");
+    if p == Some(2) {
+        assert!(
+            b.is_some(),
+            "half-applied DELETE: the primary was invalidated but B was never told (client saw {client_result:?}); the stop cancelled the in-flight leg before its fan-out"
+        );
+    }
+    if matches!(client_result, Ok(204)) {
+        assert_eq!(p, Some(2), "the client was told 204 but the primary still serves the old version");
+        assert!(b.is_some(), "the client was told 204 but B never learned of the DELETE after the stop and restart");
+    }
+}
