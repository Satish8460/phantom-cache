+// K17 (+K21): a storm of concurrent DELETEs, kill, restart, and new DELETEs DURING the replay.
+// Falsifies: "group commit / replay loses an accepted DELETE", "a DELETE during replay is lost".
+// ------------------------------------------------------------------------------------------
+#[tokio::test]
+async fn k17_concurrent_delete_storm_kill_restart_all_converge() {
+    let _serial = SERIAL.lock().await;
+    const N: usize = 120;
+    let mut h = start(&[G, B, P], vec![]).await;
+    let paths = paths_with_primary(P, 3, "k17", 2 * N);
+    let (first, second) = paths.split_at(N);
+    for p in first.iter().chain(second.iter()) {
+        warm_all(&h, p, &[G, B, P]).await;
+    }
+    for p in first.iter().chain(second.iter()) {
+        assert_eq!(h.origin().mutate_key(p, "v2"), 2);
+    }
+    h.set_link_mode(G, B, FaultMode::Blackhole).await;
+    // storm: all first-wave DELETEs through G, 24 at a time
+    let accepted: Vec<String> = {
+        use futures_util::stream::{self, StreamExt};
+        let hr = &h;
+        stream::iter(first.iter().cloned())
+            .map(|p| async move { (hr.http_delete(G, &p).await.ok().map(|c| c.as_u16()), p) })
+            .buffer_unordered(24)
+            .filter_map(|(st, p)| async move { (st == Some(204)).then_some(p) })
+            .collect()
+            .await
+    };
+    eprintln!("[K17] {} / {N} DELETEs answered 204", accepted.len());
+    assert!(accepted.len() >= N * 9 / 10, "storm should be accepted (loopback): {}", accepted.len());
+    h.kill_node(G).await.unwrap();
+    h.set_link_mode(G, B, FaultMode::Normal).await;
+    h.restart_node(G, &[]).await.unwrap();
+    let (line, owed) = last_replay(&h);
+    eprintln!("[K17] {line}");
+    // K21: new DELETEs while the replay is being delivered
+    let mut accepted2 = Vec::new();
+    for p in second.iter().take(40) {
+        if h.http_delete(G, p).await.ok().map(|c| c.as_u16()) == Some(204) {
+            accepted2.push(p.clone());
+        }
+    }
+    assert!(owed >= 1, "at least the unacknowledged part of the storm must be replayed: {line}");
+    let deadline = Instant::now() + Duration::from_secs(40);
+    let mut missing: Vec<String> = accepted.iter().chain(accepted2.iter()).cloned().collect();
+    while !missing.is_empty() && Instant::now() < deadline {
+        let mut still = Vec::new();
+        for p in &missing {
+            if version_on(&h, B, p).await != Some(2) {
+                still.push(p.clone());
+            }
+        }
+        missing = still;
+        if !missing.is_empty() {
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    }
+    assert!(missing.is_empty(), "{} accepted DELETE(s) never converged on B, e.g. {:?}", missing.len(), missing.iter().take(3).collect::<Vec<_>>());
+}
