+//! M3 rework v2: router-level tests that run in the DEFAULT build (no failpoints, no processes).
+//! AI-written; not independently verified.
+//!
+//! * F-04 (router level): `invalidate_key_across_cluster` must not return (so no 204 can be built)
+//!   before the owed set is in the log file, even when the writer is slow.
+//! * F-05: the shutdown drain must count a task that still sits in the broadcaster's main queue.
+
+use phantom_cache_demo::dist::frame::InvalidationScope;
+use phantom_cache_demo::dist::node::{NodeState, VirtualNode};
+use phantom_cache_demo::dist::router::durable_log::{DurableLog, Hooks, LogConfig};
+use phantom_cache_demo::dist::router::{RendezvousRouter, ReplicaInvalidationTask};
+use std::sync::atomic::Ordering;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+async fn two_nodes() -> (Arc<VirtualNode>, Arc<VirtualNode>) {
+    let n1 = Arc::new(VirtualNode::new(1));
+    let a1 = n1.start_tcp_service("127.0.0.1:0").await.unwrap();
+    n1.set_addr(a1);
+    n1.set_state(NodeState::Active);
+    let n2 = Arc::new(VirtualNode::new(2));
+    let a2 = n2.start_tcp_service("127.0.0.1:0").await.unwrap();
+    n2.set_addr(a2);
+    n2.set_state(NodeState::Active);
+    (n1, n2)
+}
+
+fn tmpdir(tag: &str) -> std::path::PathBuf {
+    let d = std::env::temp_dir().join(format!("m3router_{}_{}_{}", tag, std::process::id(), rand_u32()));
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn rand_u32() -> u32 {
+    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.subsec_nanos()).unwrap_or(7)
+}
+
+/// F-04. Falsifies: "the router can complete an accepted invalidation before its owed set is durable".
+/// The log writer is stalled for 400 ms. The call must take at least that long, and at the moment it
+/// returns the key must already be in the log file; the log must have counted an fsync.
+#[tokio::test]
+async fn f04_router_does_not_return_before_the_owed_set_is_in_the_log_file() {
+    let (n1, n2) = two_nodes().await;
+    let router = RendezvousRouter::new(vec![n1.clone(), n2.clone()]);
+    let dir = tmpdir("f04");
+    let path = dir.join("inval.log");
+    let hooks = Arc::new(Hooks::default());
+    let cfg = LogConfig { hooks: Some(hooks.clone()), durability_wait: Duration::from_secs(10), ..LogConfig::default() };
+    let (log, _rep) = DurableLog::open(&path, 1, &[2], cfg).unwrap();
+    router.broadcaster().repair_ledger().attach_durable(log.clone());
+
+    hooks.stall_ms.store(400, Ordering::Relaxed);
+    let key = "__default__:/f04_router_key";
+    let t = Instant::now();
+    let res = router.invalidate_key_across_cluster(key, InvalidationScope::ExactKey).await;
+    let took = t.elapsed();
+    assert!(res.is_ok(), "{res:?}");
+    assert!(took >= Duration::from_millis(350), "returned after {took:?}: the 204 could be built before the intent was written");
+    let bytes = std::fs::read(&path).unwrap();
+    assert!(
+        bytes.windows(key.len()).any(|w| w == key.as_bytes()),
+        "the call returned but the key is not in the log file"
+    );
+    assert!(log.stats.fsyncs.load(Ordering::Relaxed) >= 1, "returned before any fsync (fsync=always)");
+
+    hooks.stall_ms.store(0, Ordering::Relaxed);
+    router.stop();
+    log.close(false);
+    n1.stop_tcp_service();
+    n2.stop_tcp_service();
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// F-05. Falsifies: "`drain` reports complete while a task still sits in the broadcaster's main
+/// queue". On the current-thread test runtime the dispatcher cannot run before the first await, so
+/// right after `enqueue` the task is certainly still queued.
+#[tokio::test]
+async fn f05_drain_counts_tasks_still_in_the_broadcaster_main_queue() {
+    let (n1, n2) = two_nodes().await;
+    let router = RendezvousRouter::new(vec![n1.clone(), n2.clone()]);
+    let task = ReplicaInvalidationTask {
+        key: "__default__:/f05_queued".to_string(),
+        scope: InvalidationScope::ExactKey,
+        replica_node_ids: vec![2],
+        membership_epoch: 0,
+    };
+    assert!(router.broadcaster().enqueue(task));
+    let early = router.drain(Duration::ZERO).await;
+    assert!(!early.complete, "drain claimed completion with a task queued: {early:?}");
+    assert_eq!(early.pending_jobs, 1, "the queued task must be counted: {early:?}");
+    // given time, the dispatcher hands it over, the worker delivers it, and the count returns to 0
+    let done = router.drain(Duration::from_secs(5)).await;
+    assert!(done.complete, "drain did not complete once the dispatcher ran: {done:?}");
+    assert_eq!(done.pending_jobs, 0, "{done:?}");
+    router.stop();
+    n1.stop_tcp_service();
+    n2.stop_tcp_service();
+}
