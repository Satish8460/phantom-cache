+        let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+        let pid = gw.child.id().ok_or("gateway already exited")?;
+        #[cfg(windows)]
+        send_ctrl_break(pid)?;
+        #[cfg(unix)]
