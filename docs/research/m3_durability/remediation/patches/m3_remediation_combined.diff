+struct Crash {
+    h: ClusterHarness,
+    path: String,
+    delete_status: Option<u16>,
+    issuer_exit: Result<String, String>,
+}
+
+/// The common crash scenario: arm `fp` on the issuer, warm the key everywhere, change the origin,
+/// blackhole G->B, DELETE via G, wait for the issuer to die at the failpoint, heal and restart it
+/// WITHOUT the failpoint.
+async fn crash_at(fp: &str, tag: &str, extra: &[(String, String)]) -> Crash {
+    let mut h = start(&[G, B, P], vec![]).await;
+    arm(&mut h, fp, extra).await;
+    let path = paths_with_primary(P, 3, tag, 1).remove(0);
+    warm_all(&h, &path, &[G, B, P]).await;
+    assert_eq!(h.origin().mutate_key(&path, "v2"), 2);
+    h.set_link_mode(G, B, FaultMode::Blackhole).await;
+    let delete_status = h.http_delete_with_timeout(G, &path, Duration::from_secs(10)).await.map(|c| c.as_u16());
+    let issuer_exit = h.wait_node_exit(G, Duration::from_secs(10)).await;
+    h.set_link_mode(G, B, FaultMode::Normal).await;
+    disarm_restart(&mut h).await;
+    Crash { h, path, delete_status, issuer_exit }
+}
+
+fn assert_exit_137(c: &Crash) {
+    let e = c.issuer_exit.as_ref().unwrap_or_else(|e| panic!("issuer did not die at the failpoint: {e}"));
+    assert!(e.contains("137"), "issuer should have exited with 137 at the failpoint, got {e}");
+}
