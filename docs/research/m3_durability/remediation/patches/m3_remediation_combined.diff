+//! PROPOSED PATCH (investigation prototype, validated only in a scratch copy, NOT integrated).
+//!
+//! Opt-in durable owed-invalidation log (M3). Off unless `PHANTOM_INVALIDATION_LOG_PATH` is set.
+//!
+//! Purpose: an invalidation that this gateway accepted (DELETE answered 204) but that some peer has
+//! not acknowledged yet must survive a crash/restart of this gateway, so that the restarted
+//! gateway can keep delivering it. Failure model: process crash / kill -9 / SIGTERM / restart.
+//! With `fsync=always` also power loss / OS crash. Disk loss is excluded.
+//!
+//! File format (all integers little endian), version 1:
+//!   header (20 bytes): magic "PCIL" | version u16 | node_id u8 | reserved u8 | created_unix_ms u64
+//!                      | crc32 u32 (over the preceding 16 bytes)
+//!   record: body_len u32 | body | crc32 u32 (over body_len bytes and body)
+//!   body  : type u8 | payload
+//!     1 Intent      stamp u64 | unix_ms u64 | scope u8 | key_len u16 | key | npeers u8 | peers u8*npeers
+//!     2 Ack         peer u8 | scope u8 | key_len u16 | key | upto_stamp u64
+//!     3 FlushMarker peer u8 | stamp u64 | unix_ms u64      (peer owes a FullCache flush)
+//!     4 Checkpoint  stamp_counter u64                      (first record of a compacted file)
+//!     5 Clean       unix_ms u64                            (informational: orderly shutdown)
+//!
+//! The stream sequence counters and the replay ring are NOT persisted (a restarted gateway starts
+//! new streams; the receiver applies every InvalidateRequest regardless of sequence).
+//!
+//! In-memory image (`State`) mirrors the repair-ledger bounds (entries and key bytes per peer, tenant
+//! collapse, then full-flush marker). It is rebuilt from the log on boot and re-injected into the live
+//! `RepairLedger` by the caller.
+
+use crate::dist::frame::{InvalidationScope, MAX_KEY_LENGTH_BYTES};
+use crate::dist::router::{
+    tenant_of_canonical, REPAIR_MAX_ENTRIES_PER_PEER, REPAIR_MAX_KEY_BYTES_PER_PEER,
+    REPAIR_MAX_TENANT_FLUSHES_PER_PEER,
+};
+use std::collections::{BTreeMap, HashMap};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::mpsc;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+pub const MAGIC: &[u8; 4] = b"PCIL";
+pub const VERSION: u16 = 1;
+pub const HEADER_LEN: usize = 20;
+/// Largest record body accepted on replay (a 4096-byte key plus 255 peers plus fixed fields).
+pub const MAX_BODY: usize = 8192;
+const CHANNEL_CAPACITY: usize = 8192;
+
+const T_INTENT: u8 = 1;
+const T_ACK: u8 = 2;
+const T_FLUSH: u8 = 3;
+const T_CHECKPOINT: u8 = 4;
+const T_CLEAN: u8 = 5;
+
+// ---------------------------------------------------------------------------
+// CRC-32 (IEEE 802.3, reflected, poly 0xEDB88320); table built at compile time, no dependency.
+// ---------------------------------------------------------------------------
+const fn make_crc_table() -> [u32; 256] {
+    let mut table = [0u32; 256];
+    let mut i = 0;
+    while i < 256 {
+        let mut c = i as u32;
+        let mut k = 0;
+        while k < 8 {
+            c = if c & 1 != 0 { 0xEDB8_8320 ^ (c >> 1) } else { c >> 1 };
+            k += 1;
+        }
+        table[i] = c;
+        i += 1;
+    }
+    table
+}
+static CRC_TABLE: [u32; 256] = make_crc_table();
+
+pub fn crc32(parts: &[&[u8]]) -> u32 {
+    let mut c = 0xFFFF_FFFFu32;
+    for p in parts {
+        for &b in *p {
+            c = CRC_TABLE[((c ^ b as u32) & 0xFF) as usize] ^ (c >> 8);
+        }
+    }
+    !c
+}
+
+/// Crash-point instrumentation for the M3 test matrix (`cargo test --features m3-failpoints`).
+/// With the feature OFF (the default and every production build) this is an empty inline function.
+/// With it ON, a gateway whose environment names this point in `PHANTOM_M3_FAILPOINT`
+/// (comma separated) terminates itself at once with exit code 137, without running any shutdown
+/// path: the closest in-process equivalent of kill -9 at an exact code location.
+#[cfg(feature = "m3-failpoints")]
+pub fn failpoint(name: &str) {
+    if let Ok(v) = std::env::var("PHANTOM_M3_FAILPOINT") {
+        if v.split(',').any(|p| !p.is_empty() && p == name) {
+            eprintln!("[failpoint] {name}: terminating the process now (exit 137)");
+            std::process::exit(137);
+        }
+    }
+}
+#[cfg(not(feature = "m3-failpoints"))]
+#[inline(always)]
+pub fn failpoint(_name: &str) {}
+
+fn now_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
+
+// ---------------------------------------------------------------------------
+// Configuration, public types
+// ---------------------------------------------------------------------------
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FsyncPolicy {
+    /// Group commit: an intent is acknowledged to its caller only after the batch containing it was
+    /// fsync'ed. Survives power loss.
+    Always,
+    /// Writes reach the OS before the caller is released; fsync at most every `n` ms. Survives a
+    /// process crash; power loss may lose up to `n` ms of intents.
+    Interval(Duration),
+    /// Never fsync. Survives a process crash (data is in the OS page cache), not an OS crash.
+    Never,
+}
+
+impl FsyncPolicy {
+    pub fn parse(s: &str) -> Option<Self> {
+        match s {
+            "always" => Some(Self::Always),
+            "interval" => Some(Self::Interval(Duration::from_millis(100))),
+            "never" => Some(Self::Never),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct LogConfig {
+    pub fsync: FsyncPolicy,
+    /// Compaction is considered once the file exceeds this many bytes.
+    pub compact_min_bytes: u64,
+    /// Hard cap of the file size; exceeding it forces a compaction, and failing that, degrades.
+    pub max_file_bytes: u64,
+    /// Debts older than this are dropped at replay/compaction (safety net for debts whose ack can
+    /// never arrive because the live ledger collapsed differently). 0 disables the age-out.
+    pub max_debt_age_ms: u64,
+    /// Fault injection for unit tests only (None in every production configuration).
+    pub hooks: Option<Arc<Hooks>>,
+}
+
+/// Fault-injection switches consulted by the writer thread (tests only; see `LogConfig::hooks`).
+#[derive(Default)]
+pub struct Hooks {
+    /// Number of upcoming batch writes that fail with an I/O error.
+    pub fail_writes: std::sync::atomic::AtomicU32,
+    /// When set, a failing write first writes the first half of the batch (a partial write).
+    pub partial_write: AtomicBool,
+    /// Number of upcoming `sync_data` calls that fail.
+    pub fail_syncs: std::sync::atomic::AtomicU32,
+    /// Milliseconds the writer sleeps before handling each batch (simulates a slow disk).
+    pub stall_ms: AtomicU64,
+}
+
+impl std::fmt::Debug for Hooks {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("Hooks")
+    }
+}
+
+impl Default for LogConfig {
+    fn default() -> Self {
+        Self {
+            fsync: FsyncPolicy::Always,
+            compact_min_bytes: 1 << 20,
+            max_file_bytes: 64 << 20,
+            max_debt_age_ms: 7 * 24 * 3600 * 1000,
+            hooks: None,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Debt {
+    pub peer: u8,
+    pub scope: InvalidationScope,
+    /// Canonical key (ExactKey), tenant id (Tenant) or "" (FullCache).
+    pub key: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReplayOutcome {
+    /// No log existed (first start).
+    Fresh,
+    /// Log replayed completely.
+    Replayed,
+    /// Replayed; an incomplete/garbled LAST record was discarded (crash during append).
+    TornTailDiscarded { dropped_bytes: u64 },
+    /// Header or a mid-file record failed validation: the log was set aside as `<path>.corrupt` and
+    /// every peer was marked as owing a full flush.
+    CorruptFallbackFlush(String),
+    /// The log file was missing although its sentinel exists (log deleted/lost): full-flush fallback.
+    LostFallbackFlush,
+}
+
+#[derive(Debug, Clone)]
+pub struct ReplayReport {
+    pub outcome: ReplayOutcome,
+    pub records: usize,
+    pub debts: Vec<Debt>,
+    pub aged_out: usize,
+    pub last_was_clean: bool,
+}
