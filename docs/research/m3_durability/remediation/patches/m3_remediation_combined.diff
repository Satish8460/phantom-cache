+#[derive(Default)]
+pub struct LogStats {
+    pub intents: AtomicU64,
+    pub acks: AtomicU64,
+    pub fsyncs: AtomicU64,
+    pub compactions: AtomicU64,
+    pub write_errors: AtomicU64,
+    pub dropped_acks: AtomicU64,
+    pub file_bytes: AtomicU64,
+    /// Set after an unrecoverable write error: new intents are no longer durable (fail-open).
+    /// Cleared again when a later rewrite of the log succeeds.
+    pub degraded: AtomicBool,
+    /// Times the log file was rewritten from the in-memory image after a write or fsync error.
+    pub rotations: AtomicU64,
+    /// Intents that could not be made durable (channel full beyond the back-pressure bound,
+    /// or a write error that could not be recovered). Each one is a DELETE that proceeded fail-open.
+    pub not_durable: AtomicU64,
+}
+
+/// The log could not make an intent durable. Fail-open: the caller proceeds (the DELETE is still
+/// answered), and the loss is visible in `LogStats::not_durable` / `write_errors` / `degraded`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct LogError;
+
+/// Upper bound on how long `append_intent` waits for room in a full command channel before it
+/// gives up and the DELETE proceeds fail-open (counted in `LogStats::not_durable`).
+const BACKPRESSURE_MAX: Duration = Duration::from_millis(500);
+
+// ---------------------------------------------------------------------------
+// In-memory image of what is owed (mirrors the RepairLedger bounds)
+// ---------------------------------------------------------------------------
+#[derive(Default, Clone, Debug)]
+struct PeerDebt {
+    /// (stamp, unix_ms) of a pending FullCache flush.
+    flush: Option<(u64, u64)>,
+    entries: HashMap<(u8, String), (u64, u64)>,
+    key_bytes: usize,
+}
+
+#[derive(Default, Clone, Debug)]
+struct State {
+    peers: BTreeMap<u8, PeerDebt>,
+    counter: u64,
+}
+
+impl State {
+    fn set_flush(p: &mut PeerDebt, stamp: u64, ms: u64) {
+        let (s, m) = p.flush.map_or((stamp, ms), |(s, m)| (s.max(stamp), m.max(ms)));
+        p.flush = Some((s, m));
+        p.entries.clear();
+        p.key_bytes = 0;
+    }
+
+    fn apply_intent(&mut self, stamp: u64, ms: u64, scope: InvalidationScope, key: &str, peers: &[u8]) {
+        self.counter = self.counter.max(stamp);
+        for &peer in peers {
+            let p = self.peers.entry(peer).or_default();
+            Self::add_entry(p, stamp, ms, scope, key);
+        }
+    }
+
+    fn add_entry(p: &mut PeerDebt, stamp: u64, ms: u64, scope: InvalidationScope, key: &str) {
+        if p.flush.is_some() || scope == InvalidationScope::FullCache {
+            Self::set_flush(p, stamp, ms);
+            return;
+        }
+        let idx = (scope.to_u8(), key.to_string());
+        if let Some(e) = p.entries.get_mut(&idx) {
+            e.0 = e.0.max(stamp);
+            e.1 = e.1.max(ms);
+            return;
+        }
+        if scope == InvalidationScope::ExactKey {
+            let tenant = tenant_of_canonical(key);
+            if let Some(e) = p.entries.get_mut(&(InvalidationScope::Tenant.to_u8(), tenant)) {
+                e.0 = e.0.max(stamp);
+                e.1 = e.1.max(ms);
+                return;
+            }
+        }
+        while p.entries.len() >= REPAIR_MAX_ENTRIES_PER_PEER
+            || p.key_bytes.saturating_add(key.len()) > REPAIR_MAX_KEY_BYTES_PER_PEER
+        {
+            if !Self::collapse_largest_tenant(p, key, scope) {
+                Self::set_flush(p, stamp, ms);
+                return;
+            }
+            if scope == InvalidationScope::ExactKey {
+                let tenant = tenant_of_canonical(key);
+                if let Some(e) = p.entries.get_mut(&(InvalidationScope::Tenant.to_u8(), tenant)) {
+                    e.0 = e.0.max(stamp);
+                    e.1 = e.1.max(ms);
+                    return;
+                }
+            }
+        }
+        p.key_bytes += key.len();
+        p.entries.insert(idx, (stamp, ms));
+    }
+
+    fn collapse_largest_tenant(p: &mut PeerDebt, pending_key: &str, pending_scope: InvalidationScope) -> bool {
+        let tenant_flushes = p.entries.keys().filter(|(s, _)| *s == InvalidationScope::Tenant.to_u8()).count();
+        if tenant_flushes >= REPAIR_MAX_TENANT_FLUSHES_PER_PEER {
+            return false;
+        }
+        let mut counts: HashMap<String, usize> = HashMap::new();
+        for (s, k) in p.entries.keys() {
+            if *s == InvalidationScope::ExactKey.to_u8() {
+                *counts.entry(tenant_of_canonical(k)).or_insert(0) += 1;
+            }
+        }
+        if pending_scope == InvalidationScope::ExactKey {
+            *counts.entry(tenant_of_canonical(pending_key)).or_insert(0) += 1;
+        }
+        let (tenant, n) = match counts.into_iter().max_by(|a, b| a.1.cmp(&b.1).then_with(|| b.0.cmp(&a.0))) {
+            Some(x) => x,
+            None => return false,
+        };
+        if n < 2 {
+            return false;
+        }
+        let mut max_stamp = 0u64;
+        let mut max_ms = 0u64;
+        let mut bytes = 0usize;
+        let mut kept = HashMap::new();
+        for ((s, k), (st, ms)) in p.entries.drain() {
+            if s == InvalidationScope::ExactKey.to_u8() && tenant_of_canonical(&k) == tenant {
+                max_stamp = max_stamp.max(st);
+                max_ms = max_ms.max(ms);
+                continue;
+            }
+            bytes += k.len();
+            kept.insert((s, k), (st, ms));
+        }
+        p.entries = kept;
+        p.key_bytes = bytes;
+        let tkey = (InvalidationScope::Tenant.to_u8(), tenant.clone());
+        if let Some(e) = p.entries.get_mut(&tkey) {
+            e.0 = e.0.max(max_stamp);
+            e.1 = e.1.max(max_ms);
+        } else {
+            p.key_bytes += tenant.len();
+            p.entries.insert(tkey, (max_stamp, max_ms));
+        }
+        true
+    }
+
+    /// An acknowledged delivery of `(scope, key)` that STARTED after stamp `upto` was assigned
+    /// covers every owed invalidation of that key (or tenant, or everything) with stamp <= upto.
+    fn apply_ack(&mut self, peer: u8, scope: InvalidationScope, key: &str, upto: u64) {
+        let p = match self.peers.get_mut(&peer) {
+            Some(p) => p,
+            None => return,
+        };
+        match scope {
+            InvalidationScope::FullCache => {
+                if matches!(p.flush, Some((s, _)) if s <= upto) {
+                    p.flush = None;
+                }
+                p.entries.retain(|_, (s, _)| *s > upto);
+            }
+            InvalidationScope::Tenant => {
+                p.entries.retain(|(sc, k), (s, _)| {
+                    let covered = *s <= upto
+                        && ((*sc == InvalidationScope::Tenant.to_u8() && k == key)
+                            || (*sc == InvalidationScope::ExactKey.to_u8() && tenant_of_canonical(k) == key));
+                    !covered
+                });
+            }
+            InvalidationScope::ExactKey => {
+                let idx = (scope.to_u8(), key.to_string());
+                if matches!(p.entries.get(&idx), Some((s, _)) if *s <= upto) {
+                    p.entries.remove(&idx);
+                }
+            }
+        }
+        p.key_bytes = p.entries.keys().map(|(_, k)| k.len()).sum();
+        if p.flush.is_none() && p.entries.is_empty() {
+            self.peers.remove(&peer);
+        }
+    }
+
+    /// Safety net for debts whose ack can never arrive (ledger/image divergence). A debt older than
+    /// `max_age_ms` is NEVER silently forgotten: the wall clock cannot tell "old" from "the clock
+    /// stepped forward", so every aged entry of a peer is replaced by ONE pending full flush for that
+    /// peer (constant size, coarse but safe, the same rule the ledger applies to removed members).
+    /// A pending flush itself never ages out. Records dated in the future (backward clock step) are
+    /// never aged. Returns one human-readable line per escalated entry (the caller logs them).
+    fn age_out(&mut self, now: u64, max_age_ms: u64) -> Vec<String> {
+        let mut lines = Vec::new();
+        if max_age_ms == 0 {
+            return lines;
+        }
+        let mut counter = self.counter;
+        for (&peer, p) in self.peers.iter_mut() {
+            let aged: Vec<String> = p
+                .entries
+                .iter()
+                .filter(|(_, (_, ms))| now.saturating_sub(*ms) > max_age_ms)
+                .map(|((sc, k), (_, ms))| format!("peer {peer} scope {sc} key {k:?} age {} ms", now.saturating_sub(*ms)))
+                .collect();
+            if aged.is_empty() {
+                continue;
+            }
+            lines.extend(aged);
+            counter += 1;
+            Self::set_flush(p, counter, now);
+        }
+        self.counter = counter;
+        lines
+    }
+
+    /// Debts of peers that are no longer members cannot be delivered by this node. Like the ledger
+    /// does for removed members, each such peer is reduced to ONE pending full flush (constant
+    /// size) so a member re-admitted later is flushed rather than silently keeping stale entries.
+    /// Returns the ids that were collapsed.
+    fn collapse_departed(&mut self, members: &[u8], now: u64) -> Vec<u8> {
+        let mut out = Vec::new();
+        let mut counter = self.counter;
+        for (&peer, p) in self.peers.iter_mut() {
+            if members.contains(&peer) || (p.flush.is_some() && p.entries.is_empty()) {
+                continue;
+            }
+            counter += 1;
+            Self::set_flush(p, counter, now);
+            out.push(peer);
+        }
+        self.counter = counter;
+        out
+    }
+
+    fn debts(&self) -> Vec<Debt> {
+        let mut out = Vec::new();
+        for (&peer, p) in &self.peers {
+            if p.flush.is_some() {
+                out.push(Debt { peer, scope: InvalidationScope::FullCache, key: String::new() });
+            }
+            let mut es: Vec<_> = p.entries.iter().collect();
+            es.sort_by_key(|(_, (st, _))| *st);
+            for ((sc, k), _) in es {
+                if let Ok(scope) = InvalidationScope::from_u8(*sc) {
+                    out.push(Debt { peer, scope, key: k.clone() });
+                }
+            }
+        }
+        out
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Record encoding / decoding
+// ---------------------------------------------------------------------------
+fn frame_record(body: &[u8], out: &mut Vec<u8>) {
+    let len = (body.len() as u32).to_le_bytes();
+    out.extend_from_slice(&len);
+    out.extend_from_slice(body);
+    out.extend_from_slice(&crc32(&[&len, body]).to_le_bytes());
+}
+
+fn enc_intent(stamp: u64, ms: u64, scope: InvalidationScope, key: &str, peers: &[u8], out: &mut Vec<u8>) {
+    let mut b = Vec::with_capacity(24 + key.len() + peers.len());
+    b.push(T_INTENT);
+    b.extend_from_slice(&stamp.to_le_bytes());
+    b.extend_from_slice(&ms.to_le_bytes());
+    b.push(scope.to_u8());
+    b.extend_from_slice(&(key.len() as u16).to_le_bytes());
+    b.extend_from_slice(key.as_bytes());
+    b.push(peers.len() as u8);
+    b.extend_from_slice(peers);
+    frame_record(&b, out);
+}
+
+fn enc_ack(peer: u8, scope: InvalidationScope, key: &str, upto: u64, out: &mut Vec<u8>) {
+    let mut b = Vec::with_capacity(16 + key.len());
+    b.push(T_ACK);
+    b.push(peer);
+    b.push(scope.to_u8());
+    b.extend_from_slice(&(key.len() as u16).to_le_bytes());
+    b.extend_from_slice(key.as_bytes());
+    b.extend_from_slice(&upto.to_le_bytes());
+    frame_record(&b, out);
+}
+
+fn enc_flush(peer: u8, stamp: u64, ms: u64, out: &mut Vec<u8>) {
+    let mut b = vec![T_FLUSH, peer];
+    b.extend_from_slice(&stamp.to_le_bytes());
+    b.extend_from_slice(&ms.to_le_bytes());
+    frame_record(&b, out);
+}
+
+fn enc_checkpoint(counter: u64, out: &mut Vec<u8>) {
+    let mut b = vec![T_CHECKPOINT];
+    b.extend_from_slice(&counter.to_le_bytes());
+    frame_record(&b, out);
+}
+
+fn enc_clean(ms: u64, out: &mut Vec<u8>) {
+    let mut b = vec![T_CLEAN];
+    b.extend_from_slice(&ms.to_le_bytes());
+    frame_record(&b, out);
+}
+
+fn header_bytes(node_id: u8) -> Vec<u8> {
+    let mut h = Vec::with_capacity(HEADER_LEN);
+    h.extend_from_slice(MAGIC);
+    h.extend_from_slice(&VERSION.to_le_bytes());
+    h.push(node_id);
+    h.push(0);
+    h.extend_from_slice(&now_ms().to_le_bytes());
+    let c = crc32(&[&h]);
+    h.extend_from_slice(&c.to_le_bytes());
+    h
+}
+
+struct Cursor<'a> {
+    b: &'a [u8],
+    i: usize,
+}
+impl<'a> Cursor<'a> {
+    fn take(&mut self, n: usize) -> Result<&'a [u8], String> {
+        if self.i + n > self.b.len() {
+            return Err("record body shorter than its fields".into());
+        }
+        let s = &self.b[self.i..self.i + n];
+        self.i += n;
+        Ok(s)
+    }
+    fn u8(&mut self) -> Result<u8, String> {
+        Ok(self.take(1)?[0])
+    }
+    fn u16(&mut self) -> Result<u16, String> {
+        Ok(u16::from_le_bytes(self.take(2)?.try_into().unwrap()))
+    }
+    fn u64(&mut self) -> Result<u64, String> {
+        Ok(u64::from_le_bytes(self.take(8)?.try_into().unwrap()))
+    }
+    fn key(&mut self) -> Result<String, String> {
+        let n = self.u16()? as usize;
+        if n > MAX_KEY_LENGTH_BYTES {
+            return Err("key longer than the frame cap".into());
+        }
+        String::from_utf8(self.take(n)?.to_vec()).map_err(|_| "key is not UTF-8".to_string())
+    }
+}
+
+fn scope_of(v: u8) -> Result<InvalidationScope, String> {
+    InvalidationScope::from_u8(v).map_err(|_| format!("unknown scope {v}"))
+}
+
+enum Tail {
+    Clean,
+    Torn(u64),
+}
+
+struct Parsed {
+    state: State,
+    records: usize,
+    valid_len: usize,
+    tail: Tail,
+    last_clean: bool,
+}
+
+/// Parses a log image. `Err` = corruption that must trigger the full-flush fallback; a torn tail
+/// (incomplete or garbled LAST record, or a zero-filled tail) is tolerated and reported.
+fn parse(bytes: &[u8], node_id: u8) -> Result<Parsed, String> {
+    if bytes.len() < HEADER_LEN {
+        return Err("file shorter than the header".into());
+    }
+    if &bytes[0..4] != MAGIC {
+        return Err("bad magic".into());
+    }
+    let ver = u16::from_le_bytes([bytes[4], bytes[5]]);
+    if ver != VERSION {
+        return Err(format!("unsupported version {ver}"));
+    }
+    if crc32(&[&bytes[0..16]]) != u32::from_le_bytes(bytes[16..20].try_into().unwrap()) {
+        return Err("header checksum mismatch".into());
+    }
+    if bytes[6] != node_id {
+        return Err(format!("log belongs to node {} (this is node {})", bytes[6], node_id));
+    }
+    let mut st = State::default();
+    let mut i = HEADER_LEN;
+    let mut records = 0usize;
+    let mut last_clean = false;
+    loop {
+        if i == bytes.len() {
+            return Ok(Parsed { state: st, records, valid_len: i, tail: Tail::Clean, last_clean });
+        }
+        let rest = &bytes[i..];
+        if rest.iter().all(|&b| b == 0) {
+            // zero-filled tail (file extended before data reached the disk)
+            return Ok(Parsed { state: st, records, valid_len: i, tail: Tail::Torn(rest.len() as u64), last_clean });
+        }
+        if rest.len() < 4 {
+            return Ok(Parsed { state: st, records, valid_len: i, tail: Tail::Torn(rest.len() as u64), last_clean });
+        }
+        let blen = u32::from_le_bytes(rest[0..4].try_into().unwrap()) as usize;
+        if blen == 0 || blen > MAX_BODY {
+            return Err(format!("record at offset {i} has invalid length {blen}"));
+        }
+        if rest.len() < 8 + blen {
+            return Ok(Parsed { state: st, records, valid_len: i, tail: Tail::Torn(rest.len() as u64), last_clean });
+        }
+        let body = &rest[4..4 + blen];
+        let crc = u32::from_le_bytes(rest[4 + blen..8 + blen].try_into().unwrap());
+        if crc32(&[&rest[0..4], body]) != crc {
+            if rest.len() == 8 + blen {
+                // last record garbled: crash during append
+                return Ok(Parsed { state: st, records, valid_len: i, tail: Tail::Torn(rest.len() as u64), last_clean });
+            }
+            return Err(format!("record at offset {i} failed its checksum"));
+        }
+        let mut c = Cursor { b: body, i: 0 };
+        last_clean = false;
+        match c.u8()? {
+            T_INTENT => {
+                let stamp = c.u64()?;
+                let ms = c.u64()?;
+                let scope = scope_of(c.u8()?)?;
+                let key = c.key()?;
+                let n = c.u8()? as usize;
+                let peers = c.take(n)?.to_vec();
+                st.apply_intent(stamp, ms, scope, &key, &peers);
+            }
+            T_ACK => {
+                let peer = c.u8()?;
+                let scope = scope_of(c.u8()?)?;
+                let key = c.key()?;
+                let upto = c.u64()?;
+                st.apply_ack(peer, scope, &key, upto);
+            }
+            T_FLUSH => {
+                let peer = c.u8()?;
+                let stamp = c.u64()?;
+                let ms = c.u64()?;
+                st.counter = st.counter.max(stamp);
+                let p = st.peers.entry(peer).or_default();
+                State::set_flush(p, stamp, ms);
+            }
+            T_CHECKPOINT => {
+                st.counter = st.counter.max(c.u64()?);
+            }
+            T_CLEAN => {
+                let _ = c.u64()?;
+                last_clean = true;
+            }
+            t => return Err(format!("unknown record type {t} at offset {i}")),
+        }
+        records += 1;
+        i += 8 + blen;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// The log
+// ---------------------------------------------------------------------------
+enum Cmd {
+    Intent {
+        scope: InvalidationScope,
+        key: String,
+        peers: Vec<u8>,
+        done: Option<tokio::sync::oneshot::Sender<Result<u64, ()>>>,
+    },
+    Ack { peer: u8, scope: InvalidationScope, key: String, upto: u64 },
+    Close { clean: bool, done: mpsc::Sender<()> },
+    /// Completes after every command queued before it has been applied (and written).
+    Barrier { done: tokio::sync::oneshot::Sender<Result<u64, ()>> },
+}
+
+pub struct DurableLog {
+    tx: mpsc::SyncSender<Cmd>,
+    high_water: Arc<AtomicU64>,
+    pub stats: Arc<LogStats>,
+    join: Mutex<Option<std::thread::JoinHandle<()>>>,
+    path: PathBuf,
+}
+
+fn sentinel_path(path: &Path) -> PathBuf {
+    let mut s = path.as_os_str().to_owned();
+    s.push(".sentinel");
+    PathBuf::from(s)
+}
+fn tmp_path(path: &Path) -> PathBuf {
+    let mut s = path.as_os_str().to_owned();
+    s.push(".tmp");
+    PathBuf::from(s)
+}
+fn corrupt_path(path: &Path) -> PathBuf {
+    let mut s = path.as_os_str().to_owned();
+    s.push(".corrupt");
+    PathBuf::from(s)
+}
+
+fn open_append(path: &Path) -> std::io::Result<std::fs::File> {
+    let mut o = std::fs::OpenOptions::new();
+    o.create(true).append(true).read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        o.mode(0o600);
+    }
+    o.open(path)
+}
+
+fn create_new_file(path: &Path) -> std::io::Result<std::fs::File> {
+    let mut o = std::fs::OpenOptions::new();
+    o.create(true).write(true).truncate(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        o.mode(0o600);
+    }
+    o.open(path)
+}
+
+#[cfg(unix)]
+fn sync_parent(path: &Path) {
+    if let Some(dir) = path.parent() {
+        if let Ok(d) = std::fs::File::open(if dir.as_os_str().is_empty() { Path::new(".") } else { dir }) {
+            let _ = d.sync_all();
+        }
+    }
+}
+#[cfg(not(unix))]
+fn sync_parent(_path: &Path) {}
+
+/// Serialises a full image of `state` (compacted file contents).
+fn snapshot_bytes(node_id: u8, state: &State, clean: bool) -> Vec<u8> {
+    let mut out = header_bytes(node_id);
+    enc_checkpoint(state.counter, &mut out);
+    for (&peer, p) in &state.peers {
+        if let Some((st, ms)) = p.flush {
+            enc_flush(peer, st, ms, &mut out);
+        }
+        let mut es: Vec<_> = p.entries.iter().collect();
+        es.sort_by_key(|(_, (st, _))| *st);
+        for ((sc, k), (st, ms)) in es {
+            if let Ok(scope) = InvalidationScope::from_u8(*sc) {
+                enc_intent(*st, *ms, scope, k, &[peer], &mut out);
+            }
+        }
+    }
+    if clean {
+        enc_clean(now_ms(), &mut out);
+    }
+    out
+}
+
+impl DurableLog {
+    /// Opens (creating if needed) the log at `path`, replays it, and starts the writer thread.
+    /// `all_peers` = every non-local member id; used for the full-flush fallback.
+    ///
+    /// Returns the log and what must be re-injected into the live ledger. Never panics on a bad
+    /// file: corruption yields a `CorruptFallbackFlush` report with one FullCache debt per peer.
+    pub fn open(
+        path: &Path,
+        node_id: u8,
+        all_peers: &[u8],
+        cfg: LogConfig,
+    ) -> std::io::Result<(Arc<DurableLog>, ReplayReport)> {
+        if let Some(dir) = path.parent() {
+            if !dir.as_os_str().is_empty() {
+                std::fs::create_dir_all(dir)?;
+            }
+        }
+        let sentinel = sentinel_path(path);
+        let existed = path.exists();
+        let sentinel_existed = sentinel.exists();
+
+        let mut state = State::default();
+        let outcome: ReplayOutcome;
+        let mut records = 0usize;
+        let mut last_clean = false;
+        let mut fallback: Option<String> = None;
+
+        if existed {
+            let mut bytes = Vec::new();
+            std::fs::File::open(path)?.read_to_end(&mut bytes)?;
+            if bytes.is_empty() {
+                outcome = ReplayOutcome::Fresh;
+            } else if bytes.len() < HEADER_LEN && header_prefix_ok(&bytes) {
+                // crash while the header itself was being written: nothing was ever acknowledged
+                outcome = ReplayOutcome::Fresh;
+                bytes.clear();
+            } else {
+                match parse(&bytes, node_id) {
+                    Ok(p) => {
+                        records = p.records;
+                        last_clean = p.last_clean;
+                        state = p.state;
+                        match p.tail {
+                            Tail::Clean => outcome = ReplayOutcome::Replayed,
+                            Tail::Torn(n) => {
+                                outcome = ReplayOutcome::TornTailDiscarded { dropped_bytes: n };
+                                let f = std::fs::OpenOptions::new().write(true).open(path)?;
+                                f.set_len(p.valid_len as u64)?;
+                                f.sync_all()?;
+                            }
+                        }
+                    }
+                    Err(why) => {
+                        fallback = Some(why.clone());
+                        outcome = ReplayOutcome::CorruptFallbackFlush(why);
+                    }
+                }
+            }
+            if bytes.is_empty() {
+                // zero-length / torn-header file: re-initialised below
+                let _ = std::fs::remove_file(path);
+            }
+        } else if sentinel_existed {
+            outcome = ReplayOutcome::LostFallbackFlush;
+            fallback = Some("log file missing while its sentinel exists".into());
+        } else {
+            outcome = ReplayOutcome::Fresh;
+        }
+
+        let mut aged_out = 0usize;
+        let mut rewrite = false;
+        if fallback.is_none() {
+            let now = now_ms();
+            // Members that left: one pending flush each (never forgotten, never replayed per key).
+            let departed = state.collapse_departed(all_peers, now);
+            for peer in &departed {
+                eprintln!("[invalidation-log] peer {peer} is no longer a cluster member: its owed invalidations are reduced to one pending full flush (kept until acknowledged)");
+            }
+            let aged = state.age_out(now, cfg.max_debt_age_ms);
+            for line in &aged {
+                eprintln!("[invalidation-log] owed invalidation older than the age-out was escalated to a full flush of that peer (not dropped): {line}");
+            }
+            aged_out = aged.len();
+            rewrite = !departed.is_empty() || !aged.is_empty();
+        } else {
+            // Keep the evidence (one generation), start from an empty image, owe every peer a flush.
+            if existed {
+                let _ = std::fs::remove_file(corrupt_path(path));
+                let _ = std::fs::rename(path, corrupt_path(path));
+            }
+            state = State::default();
+            let stamp = 1u64;
+            let ms = now_ms();
+            for &peer in all_peers {
+                State::set_flush(state.peers.entry(peer).or_default(), stamp, ms);
+            }
+            state.counter = stamp;
+        }
+
+        // (Re)write the file as a compacted image when it is new, was corrupt, or lost debts.
+        let fresh_file = !path.exists();
+        if fresh_file || fallback.is_some() || rewrite {
+            let tmp = tmp_path(path);
+            let mut f = create_new_file(&tmp)?;
+            f.write_all(&snapshot_bytes(node_id, &state, false))?;
+            f.sync_all()?;
+            drop(f);
+            let _ = std::fs::remove_file(path);
+            std::fs::rename(&tmp, path)?;
+            sync_parent(path);
+        }
+        if !sentinel.exists() {
+            std::fs::write(&sentinel, b"phantom invalidation log sentinel\n")?;
+            sync_parent(path);
+        }
+
+        let file = open_append(path)?;
+        let file_len = file.metadata().map(|m| m.len()).unwrap_or(0);
+        let stats = Arc::new(LogStats::default());
+        stats.file_bytes.store(file_len, Ordering::Relaxed);
+        let high_water = Arc::new(AtomicU64::new(state.counter));
+        let debts = state.debts();
+        let (tx, rx) = mpsc::sync_channel::<Cmd>(CHANNEL_CAPACITY);
+
+        let writer = Writer {
+            path: path.to_path_buf(),
+            node_id,
+            cfg,
+            file,
+            state,
+            file_len,
+            next_compact_at: 0,
+            last_sync: Instant::now(),
+            dirty: false,
+            needs_rotation: false,
+            high_water: high_water.clone(),
+            stats: stats.clone(),
+        };
+        let join = std::thread::Builder::new()
+            .name("phantom-inval-log".into())
+            .spawn(move || writer.run(rx))?;
+
+        let log = Arc::new(DurableLog {
+            tx,
+            high_water,
+            stats,
+            join: Mutex::new(Some(join)),
+            path: path.to_path_buf(),
+        });
+        Ok((
+            log,
+            ReplayReport { outcome, records, debts, aged_out, last_was_clean: last_clean },
+        ))
+    }
+
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// Highest stamp assigned so far. A delivery attempt captures this BEFORE sending and passes
+    /// it to `ack` on success.
+    pub fn high_water(&self) -> u64 {
+        self.high_water.load(Ordering::SeqCst)
+    }
+
+    /// Records, and waits until durable (per the fsync policy), that `peers` owe `(scope, key)`.
+    /// Returns the stamp. `Err(())` = the log could not persist it (fail-open: the caller proceeds;
+    /// `stats.degraded` / `write_errors` make this visible).
+    /// Resolves once everything enqueued before this call has been applied and written
+    /// (useful for tests and orderly hand-offs; production paths never wait on it).
+    pub async fn barrier(&self) {
+        let (otx, orx) = tokio::sync::oneshot::channel();
+        if self.tx.try_send(Cmd::Barrier { done: otx }).is_ok() {
+            let _ = orx.await;
+        }
+    }
+
+    pub async fn append_intent(&self, scope: InvalidationScope, key: &str, peers: &[u8]) -> Result<u64, LogError> {
+        if peers.is_empty() {
+            return Ok(self.high_water());
+        }
+        let (otx, orx) = tokio::sync::oneshot::channel();
+        let mut cmd = Cmd::Intent { scope, key: key.to_string(), peers: peers.to_vec(), done: Some(otx) };
+        // A full channel means the writer is busy (slow disk, burst). Apply bounded async
+        // back-pressure (never a blocking call on a runtime worker) before giving up: a busy
+        // moment must not silently turn into "this DELETE is not durable".
+        let give_up = Instant::now() + BACKPRESSURE_MAX;
+        loop {
+            match self.tx.try_send(cmd) {
+                Ok(()) => break,
+                Err(mpsc::TrySendError::Full(c)) if Instant::now() < give_up => {
+                    cmd = c;
+                    tokio::time::sleep(Duration::from_millis(5)).await;
+                }
+                Err(_) => {
+                    self.stats.write_errors.fetch_add(1, Ordering::Relaxed);
+                    self.stats.not_durable.fetch_add(1, Ordering::Relaxed);
+                    return Err(LogError);
+                }
+            }
+        }
+        match orx.await {
+            Ok(Ok(stamp)) => Ok(stamp),
+            _ => {
+                self.stats.not_durable.fetch_add(1, Ordering::Relaxed);
+                Err(LogError)
+            }
+        }
+    }
+
+    /// Fire-and-forget intent (ledger mirror); durable at the next group commit.
+    pub fn note_owed(&self, peer: u8, scope: InvalidationScope, key: &str) {
+        let cmd = Cmd::Intent { scope, key: key.to_string(), peers: vec![peer], done: None };
+        if self.tx.try_send(cmd).is_err() {
+            self.stats.write_errors.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    /// `peer` acknowledged a delivery of `(scope, key)` that started when `high_water() == upto`.
+    /// A lost ack only causes a redundant (idempotent) re-delivery after a restart.
+    pub fn ack(&self, peer: u8, scope: InvalidationScope, key: &str, upto: u64) {
+        let cmd = Cmd::Ack { peer, scope, key: key.to_string(), upto };
+        if self.tx.try_send(cmd).is_err() {
+            self.stats.dropped_acks.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    /// Flushes everything queued, optionally writes the orderly-shutdown marker, compacts when the
+    /// image is empty, fsyncs and stops the writer thread. Blocking (call from shutdown only).
+    pub fn close(&self, clean: bool) {
+        let (dtx, drx) = mpsc::channel();
+        if self.tx.send(Cmd::Close { clean, done: dtx }).is_ok() {
+            let _ = drx.recv_timeout(Duration::from_secs(10));
+        }
+        if let Some(j) = self.join.lock().unwrap().take() {
+            let _ = j.join();
+        }
+        let st = &self.stats;
+        let (we, nd, rot) = (st.write_errors.load(Ordering::Relaxed), st.not_durable.load(Ordering::Relaxed), st.rotations.load(Ordering::Relaxed));
+        if we > 0 || nd > 0 || rot > 0 {
+            eprintln!("[invalidation-log] closed: write_errors={we} not_durable={nd} rewrites={rot} degraded={}", st.degraded.load(Ordering::Relaxed));
+        }
+    }
+}
+
+fn header_prefix_ok(bytes: &[u8]) -> bool {
+    // A file shorter than the header is a torn creation only if it is a prefix of a plausible header.
+    let n = bytes.len().min(4);
+    bytes[..n] == MAGIC[..n]
+}
+
+struct Writer {
+    path: PathBuf,
+    node_id: u8,
+    cfg: LogConfig,
+    file: std::fs::File,
+    state: State,
+    file_len: u64,
+    next_compact_at: u64,
+    last_sync: Instant,
+    dirty: bool,
+    /// The file is not trustworthy for appends (failed write or fsync): the next batch rewrites it.
+    needs_rotation: bool,
+    high_water: Arc<AtomicU64>,
+    stats: Arc<LogStats>,
+}
+
+impl Writer {
+    /// Rewrites the whole log from the in-memory image into `<path>.tmp`, fsyncs it, atomically
+    /// renames it over the log and reopens it. Used after a failed write or fsync. On success every
+    /// intent applied to the image so far is genuinely durable (per fsync of the new file) and the
+    /// degraded flag is cleared; on failure the log stays degraded and the next batch retries.
+    fn rotate(&mut self, why: &str) -> bool {
+        let image = snapshot_bytes(self.node_id, &self.state, false);
+        let tmp = tmp_path(&self.path);
+        let written = (|| -> std::io::Result<()> {
+            let mut f = create_new_file(&tmp)?;
+            f.write_all(&image)?;
+            f.sync_all()?;
+            Ok(())
+        })();
+        let renamed = written.and_then(|_| std::fs::rename(&tmp, &self.path));
+        if let Err(e) = renamed {
+            let _ = std::fs::remove_file(&tmp);
+            self.stats.write_errors.fetch_add(1, Ordering::Relaxed);
+            self.stats.degraded.store(true, Ordering::Relaxed);
+            eprintln!("[invalidation-log] rewrite after {why} FAILED ({e}); new invalidations are NOT durable until it succeeds");
+            return false;
+        }
+        sync_parent(&self.path);
+        match open_append(&self.path) {
+            Ok(f) => {
+                self.file = f;
+                self.file_len = self.file.metadata().map(|m| m.len()).unwrap_or(image.len() as u64);
+                self.stats.file_bytes.store(self.file_len, Ordering::Relaxed);
+                self.dirty = false;
+                self.needs_rotation = false;
+                self.stats.degraded.store(false, Ordering::Relaxed);
+                self.stats.rotations.fetch_add(1, Ordering::Relaxed);
+                self.next_compact_at = self.file_len.saturating_mul(2);
+                eprintln!("[invalidation-log] recovered after {why}: log rewritten from memory ({} bytes)", self.file_len);
+                true
+            }
+            Err(e) => {
+                self.stats.write_errors.fetch_add(1, Ordering::Relaxed);
+                self.stats.degraded.store(true, Ordering::Relaxed);
+                eprintln!("[invalidation-log] cannot reopen the log after {why} ({e}); degraded");
+                false
+            }
+        }
+    }
+
+    fn write_batch(&mut self, buf: &[u8]) -> std::io::Result<()> {
+        if let Some(h) = &self.cfg.hooks {
+            let n = h.fail_writes.load(Ordering::SeqCst);
+            if n > 0 {
+                h.fail_writes.store(n - 1, Ordering::SeqCst);
+                if h.partial_write.load(Ordering::Relaxed) {
+                    let _ = self.file.write_all(&buf[..buf.len() / 2]);
+                }
+                return Err(std::io::Error::other("injected write failure"));
+            }
+        }
+        self.file.write_all(buf)
+    }
+
+    fn sync_file(&mut self) -> std::io::Result<()> {
+        if let Some(h) = &self.cfg.hooks {
+            let n = h.fail_syncs.load(Ordering::SeqCst);
+            if n > 0 {
+                h.fail_syncs.store(n - 1, Ordering::SeqCst);
+                return Err(std::io::Error::other("injected fsync failure"));
+            }
+        }
+        self.file.sync_data()
+    }
+
+    fn run(mut self, rx: mpsc::Receiver<Cmd>) {
+        let mut closing: Option<(bool, mpsc::Sender<()>)> = None;
+        loop {
+            // Block for the first command (bounded, so interval fsync still happens when idle).
+            let first = match rx.recv_timeout(Duration::from_millis(100)) {
+                Ok(c) => Some(c),
+                Err(mpsc::RecvTimeoutError::Timeout) => None,
+                Err(mpsc::RecvTimeoutError::Disconnected) => break,
+            };
+            if let Some(h) = &self.cfg.hooks {
+                let ms = h.stall_ms.load(Ordering::Relaxed);
+                if ms > 0 && first.is_some() {
+                    std::thread::sleep(Duration::from_millis(ms));
+                }
+            }
+            let mut batch = Vec::new();
+            if let Some(c) = first {
+                batch.push(c);
+                while batch.len() < 512 {
+                    match rx.try_recv() {
+                        Ok(c) => batch.push(c),
+                        Err(_) => break,
+                    }
+                }
+            }
+            let mut buf: Vec<u8> = Vec::new();
+            let mut waiters: Vec<(tokio::sync::oneshot::Sender<Result<u64, ()>>, u64)> = Vec::new();
+            let mut had_intent = false;
+            for cmd in batch {
+                match cmd {
+                    Cmd::Intent { scope, key, peers, done } => {
+                        had_intent = true;
+                        let stamp = self.state.counter + 1;
+                        let ms = now_ms();
+                        self.state.apply_intent(stamp, ms, scope, &key, &peers);
+                        enc_intent(stamp, ms, scope, &key, &peers, &mut buf);
+                        self.high_water.store(stamp, Ordering::SeqCst);
+                        self.stats.intents.fetch_add(1, Ordering::Relaxed);
+                        if let Some(d) = done {
+                            waiters.push((d, stamp));
+                        }
+                    }
+                    Cmd::Ack { peer, scope, key, upto } => {
+                        self.state.apply_ack(peer, scope, &key, upto);
+                        enc_ack(peer, scope, &key, upto, &mut buf);
+                        self.stats.acks.fetch_add(1, Ordering::Relaxed);
+                    }
+                    Cmd::Barrier { done } => {
+                        waiters.push((done, self.state.counter));
+                    }
+                    Cmd::Close { clean, done } => {
+                        closing = Some((clean, done));
+                    }
+                }
+            }
+            if let Some((clean, _)) = &closing {
+                if *clean {
+                    enc_clean(now_ms(), &mut buf);
+                }
+            }
+            let mut ok = true;
+            // Set when this iteration already rewrote AND fsynced the whole file from the image.
+            let mut synced_by_rotation = false;
+            if self.needs_rotation {
+                // An earlier write or fsync failed: the file may hold a partial record or may have
+                // lost pages. This batch is already in the in-memory image, so the rewrite covers it.
+                ok = self.rotate("pending recovery");
+                synced_by_rotation = ok;
+            } else if !buf.is_empty() {
+                match self.write_batch(&buf) {
+                    Ok(()) => {
+                        self.file_len += buf.len() as u64;
+                        self.stats.file_bytes.store(self.file_len, Ordering::Relaxed);
+                        self.dirty = true;
+                    }
+                    Err(e) => {
+                        self.stats.write_errors.fetch_add(1, Ordering::Relaxed);
+                        eprintln!("[invalidation-log] WRITE FAILED ({e}); rewriting the log from memory");
+                        // A partial write may have left garbage at the tail; appending after it would
+                        // poison the file (mid-file corruption on the next boot). Never append to it again.
+                        self.needs_rotation = true;
+                        ok = self.rotate("write failure");
+                        synced_by_rotation = ok;
+                    }
+                }
+            }
+            let must_sync = closing.is_some()
+                || match self.cfg.fsync {
+                    FsyncPolicy::Always => self.dirty && !buf.is_empty(),
+                    FsyncPolicy::Interval(d) => self.dirty && self.last_sync.elapsed() >= d,
+                    FsyncPolicy::Never => false,
+                };
+            if had_intent && ok {
+                failpoint("log.after_write_before_sync");
+            }
+            if must_sync && self.dirty && !synced_by_rotation {
+                if let Err(e) = self.sync_file() {
+                    self.stats.write_errors.fetch_add(1, Ordering::Relaxed);
+                    eprintln!("[invalidation-log] FSYNC FAILED ({e}); rewriting the log into a new file");
+                    // After a failed fsync the kernel may have dropped the dirty pages; a retried fsync
+                    // on the same file can then report success without the data being on disk. Never
+                    // trust the old file again: write the image into a NEW file and fsync that.
+                    self.needs_rotation = true;
+                    ok = self.rotate("fsync failure");
+                } else {
+                    self.stats.fsyncs.fetch_add(1, Ordering::Relaxed);
+                    self.last_sync = Instant::now();
+                    self.dirty = false;
+                }
+            }
+            for (w, stamp) in waiters {
+                let _ = w.send(if ok { Ok(stamp) } else { Err(()) });
+            }
+            if ok {
+                let (is_closing, clean) = match &closing {
+                    Some((c, _)) => (true, *c),
+                    None => (false, false),
+                };
+                self.maybe_compact(is_closing, clean);
+            }
+            if let Some((_, done)) = closing.take() {
+                let _ = done.send(());
+                break;
+            }
+        }
+    }
+
+    fn maybe_compact(&mut self, closing: bool, clean: bool) {
+        let over_cap = self.file_len > self.cfg.max_file_bytes;
+        let threshold = self.next_compact_at.max(self.cfg.compact_min_bytes);
+        let empty_on_close = closing && self.state.peers.is_empty() && self.file_len > (HEADER_LEN as u64 + 64);
+        if !(self.file_len >= threshold || over_cap || empty_on_close) {
+            return;
+        }
+        for line in self.state.age_out(now_ms(), self.cfg.max_debt_age_ms) {
+            eprintln!("[invalidation-log] owed invalidation older than the age-out was escalated to a full flush of that peer (not dropped): {line}");
+        }
+        let image = snapshot_bytes(self.node_id, &self.state, closing && clean);
+        let tmp = tmp_path(&self.path);
+        let written = (|| -> std::io::Result<()> {
+            let mut f = create_new_file(&tmp)?;
+            f.write_all(&image)?;
+            f.sync_all()?;
+            Ok(())
+        })();
+        if written.is_ok() && !self.state.peers.is_empty() && self.stats.intents.load(Ordering::Relaxed) > 0 {
+            failpoint("log.compact.after_tmp");
+        }
+        if written.is_err() || std::fs::rename(&tmp, &self.path).is_err() {
+            // keep appending to the old file; it is still complete and valid
+            self.stats.write_errors.fetch_add(1, Ordering::Relaxed);
+            let _ = std::fs::remove_file(&tmp);
+            return;
+        }
+        sync_parent(&self.path);
+        if !self.state.peers.is_empty() && self.stats.intents.load(Ordering::Relaxed) > 0 {
+            failpoint("log.compact.after_rename");
+        }
+        match open_append(&self.path) {
+            Ok(f) => {
+                self.file = f;
+                self.file_len = self.file.metadata().map(|m| m.len()).unwrap_or(image.len() as u64);
+                self.stats.file_bytes.store(self.file_len, Ordering::Relaxed);
+                self.stats.compactions.fetch_add(1, Ordering::Relaxed);
+                self.dirty = false;
+                self.next_compact_at = self.file_len.saturating_mul(2);
+            }
+            Err(e) => {
+                self.stats.degraded.store(true, Ordering::Relaxed);
+                self.stats.write_errors.fetch_add(1, Ordering::Relaxed);
+                eprintln!("[invalidation-log] cannot reopen log after compaction ({e}); degraded");
+            }
+        }
+    }
+}
