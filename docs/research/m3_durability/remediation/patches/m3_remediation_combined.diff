+    let mut accepted2 = Vec::new();
+    for p in second.iter().take(40) {
+        if h.http_delete(G, p).await.ok().map(|c| c.as_u16()) == Some(204) {
+            accepted2.push(p.clone());
+        }
+    }
+    assert!(owed >= 1, "at least the unacknowledged part of the storm must be replayed: {line}");
+    let deadline = Instant::now() + Duration::from_secs(40);
+    let mut missing: Vec<String> = accepted.iter().chain(accepted2.iter()).cloned().collect();
+    while !missing.is_empty() && Instant::now() < deadline {
+        let mut still = Vec::new();
+        for p in &missing {
+            if version_on(&h, B, p).await != Some(2) {
+                still.push(p.clone());
+            }
+        }
+        missing = still;
+        if !missing.is_empty() {
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    }
+    assert!(missing.is_empty(), "{} accepted DELETE(s) never converged on B, e.g. {:?}", missing.len(), missing.iter().take(3).collect::<Vec<_>>());
+}
+
+// ------------------------------------------------------------------------------------------
+// K21b / finding 1: the client aborts the DELETE while the cluster leg is in flight.
+// G->P has a 60 ms delay per direction (RTT 120 ms < the 150 ms leg timeout); the client gives up
+// after 40 ms. Falsifies: "a client disconnect cannot lose the fan-out of a DELETE whose primary
+// leg is in flight" (the handler future may be dropped by the server).
+// ------------------------------------------------------------------------------------------
+#[tokio::test]
+async fn k21b_client_abort_during_cluster_leg_still_fans_out() {
+    let _serial = SERIAL.lock().await;
+    let h = start(&[G, B, P], vec![]).await;
+    let path = paths_with_primary(P, 3, "k21b", 1).remove(0);
+    warm_all(&h, &path, &[G, B, P]).await;
+    assert_eq!(h.origin().mutate_key(&path, "v2"), 2);
+    h.set_link_mode(G, P, FaultMode::Delay { ms: 60 }).await;
+    let st = h.http_delete_with_timeout(G, &path, Duration::from_millis(40)).await;
+    eprintln!("[K21b] client saw: {st:?} (None = aborted by the client)");
+    tokio::time::sleep(Duration::from_millis(600)).await;
+    h.set_link_mode(G, P, FaultMode::Normal).await;
+    let conv = wait_v2(&h, B, &path, Duration::from_secs(8)).await;
+    eprintln!("[K21b] B converged after {conv:?}; primary serves v{:?}", version_on(&h, P, &path).await);
+    assert!(conv.is_some(), "B never learned of the DELETE whose client aborted mid cluster-leg");
+}
