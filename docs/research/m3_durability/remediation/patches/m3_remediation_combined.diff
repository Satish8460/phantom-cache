+        got.sort_by_key(|(p, s, k)| (*p, s.to_u8(), k.clone()));
+        assert_eq!(
+            got,
+            vec![
+                (2, InvalidationScope::ExactKey, K1.to_string()),
+                (2, InvalidationScope::ExactKey, K2.to_string()),
+                (3, InvalidationScope::FullCache, String::new()),
+            ]
+        );
+        assert!(!rep2.last_was_clean);
