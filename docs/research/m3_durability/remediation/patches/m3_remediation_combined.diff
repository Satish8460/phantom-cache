+    #[tokio::test]
+    async fn truncated_last_record_is_tolerated_and_earlier_records_survive() {
+        let d = tmpdir("torn");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await.unwrap();
+        log.append_intent(InvalidationScope::ExactKey, K2, &[2]).await.unwrap();
+        log.close(false);
+        let full = std::fs::read(&p).unwrap();
+        // chop the last record in the middle (every possible cut point inside it)
+        let last_len = {
+            let mut b = Vec::new();
+            enc_intent(2, 0, InvalidationScope::ExactKey, K2, &[2], &mut b);
+            b.len()
+        };
+        let start_last = full.len() - last_len; // clean close wrote no Clean marker (close(false))
+        for cut in (start_last + 1)..full.len() {
+            std::fs::write(&p, &full[..cut]).unwrap();
+            let (l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+            assert!(
+                matches!(rep.outcome, ReplayOutcome::TornTailDiscarded { .. }),
+                "cut {cut}: {:?}",
+                rep.outcome
+            );
+            assert_eq!(rep.debts.len(), 1, "cut {cut}");
+            assert_eq!(rep.debts[0].key, K1);
+            l.close(false);
+        }
+        // garbled (bit-flipped) LAST record is also a torn tail
+        let mut garbled = full.clone();
+        let n = garbled.len();
+        garbled[n - 6] ^= 0xFF;
+        std::fs::write(&p, &garbled).unwrap();
+        let (l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert!(matches!(rep.outcome, ReplayOutcome::TornTailDiscarded { .. }), "{:?}", rep.outcome);
+        assert_eq!(rep.debts.len(), 1);
+        l.close(false);
+        // zero-filled tail
+        let mut zeros = full.clone();
+        zeros.extend_from_slice(&[0u8; 37]);
+        std::fs::write(&p, &zeros).unwrap();
+        let (l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert!(matches!(rep.outcome, ReplayOutcome::TornTailDiscarded { dropped_bytes: 37 }), "{:?}", rep.outcome);
+        assert_eq!(rep.debts.len(), 2);
+        l.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
