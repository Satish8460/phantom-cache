+    /// kill -9 equivalent for one gateway (TerminateProcess on Windows, SIGKILL on Unix): no
+    /// shutdown hooks run. Waits (bounded) until the process is reaped.
+    pub async fn kill_node(&mut self, node_id: u8) -> Result<(), String> {
+        let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+        gw.child.start_kill().map_err(|e| format!("kill failed: {e}"))?;
+        tokio::time::timeout(Duration::from_secs(5), gw.child.wait())
+            .await
+            .map_err(|_| "killed gateway did not exit within 5 s".to_string())?
+            .map_err(|e| format!("wait failed: {e}"))?;
+        Ok(())
+    }
+
+    /// Orderly stop request (SIGTERM on Unix; CTRL_BREAK to the child's process group on Windows,
+    /// which needs a shared console and may be unavailable under a detached test runner) and wait
+    /// up to `timeout` for the process to exit on its own. Returns the exit status text.
+    pub async fn graceful_stop_node(&mut self, node_id: u8, timeout: Duration) -> Result<String, String> {
+        let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+        let pid = gw.child.id().ok_or("gateway already exited")?;
+        #[cfg(windows)]
+        send_ctrl_break(pid)?;
+        #[cfg(unix)]
+        {
+            let st = std::process::Command::new("kill")
+                .arg("-TERM")
+                .arg(pid.to_string())
+                .status()
+                .map_err(|e| format!("kill -TERM failed: {e}"))?;
+            if !st.success() {
+                return Err(format!("kill -TERM exited with {st}"));
+            }
+        }
+        match tokio::time::timeout(timeout, gw.child.wait()).await {
+            Ok(Ok(status)) => Ok(format!("{status}")),
+            Ok(Err(e)) => Err(format!("wait failed: {e}")),
+            Err(_) => Err(format!("gateway did not exit within {timeout:?} of the stop request")),
+        }
+    }
+
+    /// Sends the orderly stop request without waiting for the exit (see `graceful_stop_node`).
+    pub fn request_graceful_stop(&mut self, node_id: u8) -> Result<(), String> {
+        let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+        let pid = gw.child.id().ok_or("gateway already exited")?;
+        #[cfg(windows)]
+        send_ctrl_break(pid)?;
+        #[cfg(unix)]
+        {
+            let st = std::process::Command::new("kill")
+                .arg("-TERM")
+                .arg(pid.to_string())
+                .status()
+                .map_err(|e| format!("kill -TERM failed: {e}"))?;
+            if !st.success() {
+                return Err(format!("kill -TERM exited with {st}"));
+            }
+        }
+        Ok(())
+    }
+
+    /// Waits (bounded) for a gateway process to exit; returns its exit status text.
+    pub async fn wait_node_exit(&mut self, node_id: u8, timeout: Duration) -> Result<String, String> {
+        let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+        match tokio::time::timeout(timeout, gw.child.wait()).await {
+            Ok(Ok(status)) => Ok(format!("{status}")),
+            Ok(Err(e)) => Err(format!("wait failed: {e}")),
+            Err(_) => Err(format!("gateway did not exit within {timeout:?}")),
+        }
+    }
+
+    /// Every line of a gateway's full log (all restarts) that contains one of `needles`.
+    pub fn gateway_log_lines_containing(&self, node_id: u8, needles: &[&str]) -> Vec<String> {
+        let path = match self.gateways.get(&node_id) {
+            Some(g) => g.log_path.clone(),
+            None => return Vec::new(),
+        };
+        std::fs::read(&path)
+            .map(|b| {
+                String::from_utf8_lossy(&b)
+                    .lines()
+                    .filter(|l| needles.iter().any(|n| l.contains(n)))
+                    .map(|l| l.to_string())
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    /// Restarts a stopped gateway with the identical command line, environment and ports (its
+    /// stdout/stderr is APPENDED to the same log file). `env_overrides` replace/add variables.
+    /// Returns when `/health/ready` answers and the pool pre-warm marker has been printed by the
+    /// NEW process.
+    pub async fn restart_node(&mut self, node_id: u8, env_overrides: &[(String, String)]) -> Result<(), String> {
+        let (bin, env, log_path, http_addr) = {
+            let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+            if let Ok(None) = gw.child.try_wait() {
+                return Err("gateway is still running; stop it first".into());
+            }
+            let mut env = gw.env.clone();
+            for (k, v) in env_overrides {
+                env.retain(|(ek, _)| ek != k);
+                env.push((k.clone(), v.clone()));
+            }
+            gw.env = env.clone();
+            (gw.bin_path.clone(), env, gw.log_path.clone(), gw.http_addr)
+        };
+        let before = log_count(&log_path, PREWARM_MARKER);
+        let mk = || {
+            std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(&log_path)
+                .map_err(|e| format!("cannot open gateway log: {e}"))
+        };
+        let (out, err) = (mk()?, mk()?);
+        {
+            let mut sep = mk()?;
+            use std::io::Write;
+            let _ = writeln!(sep, "\n===== [harness] restart of node {node_id} =====");
+        }
+        let child = spawn_gateway(&bin, &env, out, err).map_err(|e| format!("spawn failed: {e}"))?;
+        self.gateways.get_mut(&node_id).unwrap().child = child;
+
+        let t0 = Instant::now();
+        let budget = Duration::from_secs(15);
+        let ready_url = format!("http://{}/health/ready", http_addr);
+        loop {
+            if t0.elapsed() > budget {
+                return Err(format!(
+                    "restarted gateway {node_id} not ready within {budget:?}\n{}",
+                    tail_of_file(&log_path, 30)
+                ));
+            }
+            if let Some(gw) = self.gateways.get_mut(&node_id) {
+                if let Ok(Some(status)) = gw.child.try_wait() {
+                    return Err(format!(
+                        "restarted gateway {node_id} exited with {status}\n{}",
+                        tail_of_file(&log_path, 30)
+                    ));
+                }
+            }
+            if let Ok(resp) = self.client.get(&ready_url).send().await {
+                if resp.status() == StatusCode::OK {
+                    break;
+                }
+            }
+            tokio::time::sleep(Duration::from_millis(50)).await;
+        }
+        while log_count(&log_path, PREWARM_MARKER) <= before {
+            if t0.elapsed() > budget {
+                return Err(format!("restarted gateway {node_id}: pool pre-warm did not complete"));
+            }
+            tokio::time::sleep(Duration::from_millis(25)).await;
+        }
+        Ok(())
+    }
+
