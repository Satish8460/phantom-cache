+        // plus duplicates of one key in another tenant
+        for _ in 0..50 {
+            log.append_intent(InvalidationScope::ExactKey, "t1:/dup", &[2]).await.unwrap();
+        }
+        log.close(false);
+        let (l1, r1) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert!(r1.debts.len() <= REPAIR_MAX_ENTRIES_PER_PEER + 1, "len {}", r1.debts.len());
+        assert!(r1.debts.iter().any(|d| d.scope == InvalidationScope::Tenant && d.key == "__default__"), "{:?}", r1.debts.len());
+        assert_eq!(r1.debts.iter().filter(|d| d.key == "t1:/dup").count(), 1);
+        l1.close(false);
+        // replaying twice yields the same debts (idempotent)
+        let (l2, r2) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        let mut a: Vec<_> = r1.debts.iter().map(|d| (d.peer, d.scope.to_u8(), d.key.clone())).collect();
+        let mut b: Vec<_> = r2.debts.iter().map(|d| (d.peer, d.scope.to_u8(), d.key.clone())).collect();
+        a.sort();
+        b.sort();
+        assert_eq!(a, b);
+        l2.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[tokio::test]
+    async fn file_size_stays_bounded_under_churn_via_compaction() {
+        let d = tmpdir("churn");
+        let p = d.join("inval.log");
+        let mut c = cfg();
+        c.compact_min_bytes = 16 * 1024;
+        c.fsync = FsyncPolicy::Never;
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        for i in 0..4000 {
+            let k = format!("__default__:/churn{i}");
+            let s = log.append_intent(InvalidationScope::ExactKey, &k, &[2]).await.unwrap();
+            log.ack(2, InvalidationScope::ExactKey, &k, s);
+        }
+        let hw = log.high_water();
+        assert!(hw >= 4000);
+        log.close(false);
+        let len = std::fs::metadata(&p).unwrap().len();
+        // uncompacted this would be 4000 * (intent ~70 B + ack ~65 B) = ~540 KB
+        assert!(len < 128 * 1024, "log not compacted: {len} bytes");
+        assert!(log.stats.compactions.load(Ordering::Relaxed) >= 1);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[tokio::test]
+    async fn tenant_ack_clears_covered_exact_entries_but_not_newer_ones() {
+        let mut st = State::default();
+        st.apply_intent(1, 0, InvalidationScope::ExactKey, "t1:/a", &[2]);
+        st.apply_intent(2, 0, InvalidationScope::ExactKey, "t2:/a", &[2]);
+        st.apply_intent(5, 0, InvalidationScope::ExactKey, "t1:/b", &[2]);
+        st.apply_ack(2, InvalidationScope::Tenant, "t1", 3);
+        let keys: Vec<_> = st.debts().into_iter().map(|d| d.key).collect();
+        assert!(keys.contains(&"t2:/a".to_string()));
+        assert!(keys.contains(&"t1:/b".to_string()), "stamp 5 > upto 3 must remain");
+        assert!(!keys.contains(&"t1:/a".to_string()));
+    }
+
+    #[tokio::test]
+    async fn live_ledger_round_trip_including_inflight_complete_and_flush_marker() {
+        use crate::dist::router::RepairLedger;
+        let d = tmpdir("ledger");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        let ledger = Arc::new(RepairLedger::new());
+        assert!(ledger.attach_durable(log.clone()));
+        ledger.record(2, None, InvalidationScope::ExactKey, K1);
+        ledger.record(3, None, InvalidationScope::ExactKey, K1);
+        ledger.record(2, None, InvalidationScope::ExactKey, K2);
+        log.barrier().await;
+        // delivery of peer 2's entries starts (in flight), the first one is acknowledged
+        let batch = ledger.peek_batch(2, 10);
+        assert_eq!(batch.len(), 2);
+        assert!(batch.iter().all(|e| e.in_flight && e.durable_w >= 3));
+        ledger.complete(2, &batch[0]);
+        // peer 3 is escalated to a full flush; the flush is taken (in flight) and acknowledged
+        ledger.mark_full_flush(3);
+        log.barrier().await;
+        assert!(ledger.take_full_flush(3));
+        ledger.flush_finished(3);
+        log.barrier().await;
+        log.close(false);
+
+        let (_l, rep) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        let got: Vec<_> = rep.debts.iter().map(|d| (d.peer, d.scope, d.key.clone())).collect();
+        assert_eq!(
+            got,
+            vec![(2, InvalidationScope::ExactKey, K2.to_string())],
+            "only the unacknowledged, in-flight entry may remain owed after replay"
+        );
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[test]
+    fn crc32_matches_the_standard_check_value() {
+        assert_eq!(crc32(&[b"123456789"]), 0xCBF4_3926);
+    }
+
+    #[test]
+    fn age_out_escalates_old_debts_to_a_flush_and_keeps_young_ones_of_other_peers() {
+        // CHANGED by the remediation round: old debts used to be dropped; they are now escalated.
+        let mut st = State::default();
+        st.apply_intent(1, 1_000, InvalidationScope::ExactKey, "t1:/old", &[2]);
+        st.apply_intent(2, 9_000_000, InvalidationScope::ExactKey, "t1:/new", &[3]);
+        assert_eq!(st.age_out(9_000_100, 100_000).len(), 1);
+        let got: Vec<_> = st.debts().into_iter().map(|d| (d.peer, d.scope, d.key)).collect();
+        assert_eq!(
+            got,
+            vec![
+                (2, InvalidationScope::FullCache, String::new()),
+                (3, InvalidationScope::ExactKey, "t1:/new".to_string())
+            ]
+        );
+        assert!(st.age_out(9_000_100, 0).is_empty(), "age-out 0 disables");
+        assert!(st.age_out(9_000_100, 100_000).is_empty(), "a pending flush never ages out");
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Independent-review additions (remediation round). Each test names the property it can falsify.
+    // ---------------------------------------------------------------------------------------
+
+    fn hooked_cfg() -> (LogConfig, Arc<Hooks>) {
+        let h = Arc::new(Hooks::default());
+        let c = LogConfig { hooks: Some(h.clone()), ..LogConfig::default() };
+        (c, h)
+    }
+
+    /// Writes a log file holding one Intent (timestamp `ms`) for the given peers.
+    fn write_log_with_intent(p: &Path, ms: u64, peers: &[u8]) {
+        let mut out = header_bytes(1);
+        enc_checkpoint(1, &mut out);
+        enc_intent(1, ms, InvalidationScope::ExactKey, K1, peers, &mut out);
+        std::fs::write(p, out).unwrap();
+        std::fs::write(sentinel_path(p), b"s").unwrap();
+    }
+
+    /// Finding 5 (partial `write_all` leaves garbage mid-file).
+    /// Falsifies: "after a failed, partially written append, later appends stay readable and the
+    /// next boot replays normally instead of treating the file as corrupt (full flush of every peer)".
+    #[tokio::test]
+    async fn partial_write_failure_does_not_leave_garbage_mid_file() {
+        let d = tmpdir("pw");
+        let p = d.join("inval.log");
+        let (c, hooks) = hooked_cfg();
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        hooks.partial_write.store(true, Ordering::Relaxed);
+        hooks.fail_writes.store(1, Ordering::SeqCst);
+        let _r1 = log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await;
+        let r2 = log.append_intent(InvalidationScope::ExactKey, K2, &[2]).await;
+        assert!(r2.is_ok(), "the log must recover after one failed write");
+        assert_eq!(log.stats.rotations.load(Ordering::Relaxed), 1, "exactly one rewrite must have recovered the log");
+        assert!(!log.stats.degraded.load(Ordering::Relaxed));
+        log.close(false);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert_eq!(rep.outcome, ReplayOutcome::Replayed, "a partial write must not poison the file: {:?}", rep.outcome);
+        assert!(rep.debts.iter().any(|d| d.key == K2), "the append after the failure must be replayed");
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// Finding 4 (fsync error semantics).
+    /// Falsifies: "an intent whose fsync failed is reported durable later by a retried fsync on the
+    /// same file" (on some Linux filesystems the dirty pages are dropped after a failed fsync, so a
+    /// retry succeeds without the data). Required behaviour: the file is rewritten from the in-memory
+    /// image into a NEW file and fsynced; the intent is then genuinely durable (Ok) or reported Err.
+    #[tokio::test]
+    async fn fsync_failure_is_recovered_by_rewriting_the_log_and_the_intent_is_durable() {
+        let d = tmpdir("fs");
+        let p = d.join("inval.log");
+        let (c, hooks) = hooked_cfg();
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        hooks.fail_syncs.store(1, Ordering::SeqCst);
+        let r1 = log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await;
+        assert!(r1.is_ok(), "after a failed fsync the intent must be re-persisted by rewriting the file (or reported lost)");
+        assert_eq!(log.stats.rotations.load(Ordering::Relaxed), 1, "the old file must not be trusted again after a failed fsync");
+        log.close(false);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert!(rep.debts.iter().any(|d| d.key == K1), "the intent must be in the log");
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// Finding 6 (fail-open weakest under load).
+    /// Falsifies: "a full command channel makes the log silently stop protecting DELETEs": a burst
+    /// must be absorbed by bounded back-pressure, not turned into an immediate not-durable result.
+    #[tokio::test]
+    async fn full_command_channel_applies_backpressure_instead_of_failing_open() {
+        let d = tmpdir("bp");
+        let p = d.join("inval.log");
+        let (mut c, hooks) = hooked_cfg();
+        c.fsync = FsyncPolicy::Never;
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        hooks.stall_ms.store(60, Ordering::Relaxed);
+        for i in 0..30_000 {
+            log.note_owed(2, InvalidationScope::ExactKey, &format!("__default__:/flood_{i}"));
+        }
+        assert!(log.stats.write_errors.load(Ordering::Relaxed) > 0, "test precondition: the channel must have overflowed");
+        let r = tokio::time::timeout(
+            Duration::from_secs(5),
+            log.append_intent(InvalidationScope::ExactKey, "__default__:/the_delete", &[2]),
+        )
+        .await
+        .expect("append_intent must not hang");
+        assert!(r.is_ok(), "an accepted DELETE must not silently lose durability just because the writer is busy");
+        hooks.stall_ms.store(0, Ordering::Relaxed);
+        log.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// Finding 3 / K16 (wall-clock age-out silently drops debts after a clock step).
+    /// Falsifies: "a debt can disappear because the wall clock moved": an old-looking debt must stay
+    /// owed (escalated to a full flush of the peer), never be forgotten. A forward clock step is
+    /// indistinguishable from an old record, so the only safe action is the flush.
+    #[test]
+    fn age_out_never_silently_loses_a_debt_forward_clock_step() {
+        let d = tmpdir("ao");
+        let p = d.join("inval.log");
+        let eight_days_ms = 8 * 24 * 3600 * 1000u64;
+        write_log_with_intent(&p, now_ms().saturating_sub(eight_days_ms), &[2]);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert!(!rep.debts.is_empty(), "a debt older than the age-out must not vanish silently");
+        assert!(
+            rep.debts.iter().any(|d| d.peer == 2 && d.scope == InvalidationScope::FullCache),
+            "it must be escalated to a full flush of the peer: {:?}",
+            rep.debts
+        );
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// K16b: a BACKWARD clock step (records dated in the future) must not age anything out.
+    #[test]
+    fn backward_clock_step_does_not_age_out() {
+        let d = tmpdir("bk");
+        let p = d.join("inval.log");
+        write_log_with_intent(&p, now_ms() + 30 * 24 * 3600 * 1000, &[2]);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert_eq!(rep.debts.len(), 1);
+        assert_eq!(rep.debts[0].scope, InvalidationScope::ExactKey);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// Finding 8 (debts for departed members).
+    /// Falsifies: "debts of a peer that is no longer a member are replayed as individual keys forever
+    /// (until age-out)". The ledger's own rule for removed members is one pending flush.
+    #[test]
+    fn debts_of_departed_members_collapse_to_a_flush_marker() {
+        let d = tmpdir("dep");
+        let p = d.join("inval.log");
+        write_log_with_intent(&p, now_ms(), &[2, 7]);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2, 3], cfg()).unwrap();
+        let for7: Vec<_> = rep.debts.iter().filter(|d| d.peer == 7).collect();
+        assert!(!for7.is_empty(), "the departed member's debt must not be forgotten");
+        assert!(
+            for7.iter().all(|d| d.scope == InvalidationScope::FullCache),
+            "a departed member's debts collapse to a single flush marker: {for7:?}"
+        );
+        assert!(rep.debts.iter().any(|d| d.peer == 2 && d.scope == InvalidationScope::ExactKey), "members keep exact debts");
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// K9 (state level): a leftover `<path>.tmp` from a compaction that crashed before the rename.
+    /// Falsifies: "a stale tmp file breaks boot or is mistaken for the log".
+    #[tokio::test]
+    async fn stale_tmp_from_a_crashed_compaction_is_ignored() {
+        let d = tmpdir("tmp");
+        let p = d.join("inval.log");
+        let (log, _) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await.unwrap();
+        log.close(false);
+        std::fs::write(tmp_path(&p), b"half written compaction garbage").unwrap();
+        let (l2, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert_eq!(rep.outcome, ReplayOutcome::Replayed);
+        assert_eq!(rep.debts.len(), 1);
+        l2.close(false);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// K15c: the log cannot recover (its rewrite target is unusable): DELETEs stay fail-open (Err is
+    /// reported to the caller, the DELETE proceeds), `degraded` is visible, and the log heals itself
+    /// once the obstacle is gone.
+    #[tokio::test]
+    async fn unrecoverable_write_error_is_fail_open_visible_and_self_healing() {
+        let d = tmpdir("deg");
+        let p = d.join("inval.log");
+        let (c, hooks) = hooked_cfg();
+        let (log, _) = DurableLog::open(&p, 1, &[2], c).unwrap();
+        std::fs::create_dir(tmp_path(&p)).unwrap(); // makes the rewrite impossible
+        hooks.fail_writes.store(1, Ordering::SeqCst);
+        let r = log.append_intent(InvalidationScope::ExactKey, K1, &[2]).await;
+        assert!(r.is_err(), "no durable copy exists: the caller must be told");
+        assert!(log.stats.degraded.load(Ordering::Relaxed), "degradation must be visible");
+        std::fs::remove_dir(tmp_path(&p)).unwrap();
+        let r = log.append_intent(InvalidationScope::ExactKey, K2, &[2]).await;
+        assert!(r.is_ok(), "the log must heal once the obstacle is gone");
+        assert!(!log.stats.degraded.load(Ordering::Relaxed));
+        log.close(false);
+        let (_l, rep) = DurableLog::open(&p, 1, &[2], cfg()).unwrap();
+        assert_eq!(rep.outcome, ReplayOutcome::Replayed);
+        assert!(rep.debts.iter().any(|d| d.key == K1) && rep.debts.iter().any(|d| d.key == K2), "{:?}", rep.debts);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+}
