+    /// kill -9 equivalent for one gateway (TerminateProcess on Windows, SIGKILL on Unix): no
+    /// shutdown hooks run. Waits (bounded) until the process is reaped.
+    pub async fn kill_node(&mut self, node_id: u8) -> Result<(), String> {
+        let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+        gw.child.start_kill().map_err(|e| format!("kill failed: {e}"))?;
+        tokio::time::timeout(Duration::from_secs(5), gw.child.wait())
+            .await
+            .map_err(|_| "killed gateway did not exit within 5 s".to_string())?
+            .map_err(|e| format!("wait failed: {e}"))?;
+        Ok(())
+    }
+
+    /// Orderly stop request (SIGTERM on Unix; CTRL_BREAK to the child's process group on Windows,
+    /// which needs a shared console and may be unavailable under a detached test runner) and wait
+    /// up to `timeout` for the process to exit on its own. Returns the exit status text.
+    pub async fn graceful_stop_node(&mut self, node_id: u8, timeout: Duration) -> Result<String, String> {
+        let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+        let pid = gw.child.id().ok_or("gateway already exited")?;
+        #[cfg(windows)]
+        send_ctrl_break(pid)?;
+        #[cfg(unix)]
+        {
+            let st = std::process::Command::new("kill")
+                .arg("-TERM")
+                .arg(pid.to_string())
+                .status()
+                .map_err(|e| format!("kill -TERM failed: {e}"))?;
+            if !st.success() {
+                return Err(format!("kill -TERM exited with {st}"));
+            }
+        }
+        match tokio::time::timeout(timeout, gw.child.wait()).await {
+            Ok(Ok(status)) => Ok(format!("{status}")),
+            Ok(Err(e)) => Err(format!("wait failed: {e}")),
+            Err(_) => Err(format!("gateway did not exit within {timeout:?} of the stop request")),
+        }
+    }
+
+    /// Sends the orderly stop request without waiting for the exit (see `graceful_stop_node`).
+    pub fn request_graceful_stop(&mut self, node_id: u8) -> Result<(), String> {
+        let gw = self.gateways.get_mut(&node_id).ok_or("no such gateway")?;
+        let pid = gw.child.id().ok_or("gateway already exited")?;
+        #[cfg(windows)]
+        send_ctrl_break(pid)?;
+        #[cfg(unix)]
+        {
+            let st = std::process::Command::new("kill")
+                .arg("-TERM")
+                .arg(pid.to_string())
+                .status()
+                .map_err(|e| format!("kill -TERM failed: {e}"))?;
+            if !st.success() {
+                return Err(format!("kill -TERM exited with {st}"));
+            }
+        }
+        Ok(())
+    }
