+            .counters
+            .cache_bypasses
+            .fetch_add(1, Ordering::Relaxed);
+        let origin_base = state
+            .origin_url
+            .as_deref()
+            .unwrap_or("http://127.0.0.1:0");
+        let upstream_pol = state.get_upstream_policy();
+        return match fetch_origin_raw(origin_base, &cache_key, &clean_headers, upstream_pol.as_deref()).await {
+            Ok((status, headers_out, body)) => {
