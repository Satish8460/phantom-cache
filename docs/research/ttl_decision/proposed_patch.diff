diff --git a/tests/integration/default_ttl_wiring_tests.rs b/tests/integration/default_ttl_wiring_tests.rs
new file mode 100644
index 0000000..b972f49
--- /dev/null
+++ b/tests/integration/default_ttl_wiring_tests.rs
@@ -0,0 +1,154 @@
+//! PHANTOM_DEFAULT_TTL_MS wiring (proposed patch, docs/research/ttl_decision).
+//!
+//! Claim under test: the configured default freshness lifetime reaches the freshness engine on the
+//! real HTTP fill path, applies ONLY to responses without origin freshness information, and the
+//! unconfigured default stays 60 s. The test drives the real router (`create_app`) against an
+//! in-process origin and uses real time (the gateway reads its own wall clock), so it sleeps ~2.5 s.
+//!
+//! The process-wide default is global state, so the end-to-end scenario is ONE sequential test in
+//! this binary (no other test here touches it).
+
+use axum::{
+    extract::{Path, State},
+    http::{HeaderValue, StatusCode},
+    response::{IntoResponse, Response},
+    routing::get,
+    Json, Router,
+};
+use phantom_cache_demo::api::server::{
+    create_app, default_ttl_ms, set_default_ttl_ms, ApiState, NodeSnapshot, SimulationSnapshot, DEFAULT_TTL_MS_FALLBACK,
+};
+use phantom_cache_demo::config::*;
+use phantom_cache_demo::core::cache::PartitionedCache;
+use phantom_cache_demo::dist::node::{NodeState, VirtualNode};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+#[derive(Clone)]
+struct Origin {
+    count: Arc<AtomicU64>,
+}
+
+/// Paths starting with `ma-` carry `Cache-Control: max-age=60`; every other path carries NO
+/// freshness information at all.
+async fn origin_handler(State(s): State<Origin>, Path(path): Path<String>) -> Response {
+    let n = s.count.fetch_add(1, Ordering::SeqCst) + 1;
+    let mut resp = (StatusCode::OK, Json(serde_json::json!({ "key": path, "req_num": n }))).into_response();
+    if path.starts_with("ma-") {
+        resp.headers_mut().insert("Cache-Control", HeaderValue::from_static("max-age=60"));
+    }
+    resp
+}
+
+async fn spawn_gateway() -> (String, Arc<AtomicU64>) {
+    let count = Arc::new(AtomicU64::new(0));
+    let origin = Router::new().route("/*path", get(origin_handler)).with_state(Origin { count: count.clone() });
+    let ol = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let origin_url = format!("http://127.0.0.1:{}", ol.local_addr().unwrap().port());
+    tokio::spawn(async move {
+        axum::serve(ol, origin).await.unwrap();
+    });
+
+    let nodes = vec![Arc::new(VirtualNode::new(1))];
+    nodes[0].set_state(NodeState::Active);
+    let state = Arc::new(ApiState {
+        snapshot: Mutex::new(SimulationSnapshot {
+            version: "1.0".into(),
+            timestamp_ms: 0,
+            throughput_req_sec: 0.0,
+            p50_latency_ms: 0,
+            p95_latency_ms: 0,
+            p99_latency_ms: 0,
+            db_load_ratio: 0.0,
+            avoided_compute_dollars: 0.0,
+            nodes: vec![NodeSnapshot { node_id: 1, state: "Active".into(), cpu_utilization: 0.0, memory_used_bytes: 0 }],
+        }),
+        nodes,
+        workload_type: Mutex::new("Normal".into()),
+        cache: Some(Arc::new(PartitionedCache::new(8))),
+        origin_url: Some(origin_url),
+        telemetry: None,
+        pie: None,
+        security: None,
+        upstream_policy: None,
+        router: None,
+    });
+    let gl = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let base = format!("http://127.0.0.1:{}", gl.local_addr().unwrap().port());
+    let app = create_app(state);
+    tokio::spawn(async move {
+        axum::serve(gl, app).await.unwrap();
+    });
+    (base, count)
+}
+
+async fn status_of(c: &reqwest::Client, base: &str, key: &str) -> String {
+    let r = c.get(format!("{}/api/v1/cache/{}", base, key)).send().await.unwrap();
+    assert_eq!(r.status(), StatusCode::OK, "GET {}", key);
+    r.headers().get("X-Cache-Status").expect("X-Cache-Status").to_str().unwrap().to_string()
+}
+
+#[tokio::test]
+async fn configured_default_ttl_reaches_the_freshness_engine_through_the_real_router() {
+    // Unconfigured default is the historical 60 s (no behaviour change).
+    assert_eq!(DEFAULT_TTL_MS_FALLBACK, 60_000);
+    assert_eq!(default_ttl_ms(), 60_000);
+    let (base, origin) = spawn_gateway().await;
+    let c = reqwest::Client::new();
+
+    // Unconfigured: a header-less response is cached under the 60 s default (MISS then HIT, one fetch).
+    assert_eq!(status_of(&c, &base, "d60").await, "MISS");
+    assert_eq!(status_of(&c, &base, "d60").await, "HIT");
+    assert_eq!(origin.load(Ordering::SeqCst), 1);
+
+    // Configure a 2 s default (what main does from PHANTOM_DEFAULT_TTL_MS). Zero is ignored.
+    set_default_ttl_ms(0);
+    assert_eq!(default_ttl_ms(), 60_000, "0 must not disable the default");
+    set_default_ttl_ms(2_000);
+    assert_eq!(default_ttl_ms(), 2_000);
+
+    assert_eq!(status_of(&c, &base, "short").await, "MISS"); // origin fetch 2, no freshness headers
+    assert_eq!(status_of(&c, &base, "short").await, "HIT");
+    assert_eq!(status_of(&c, &base, "ma-long").await, "MISS"); // origin fetch 3, max-age=60
+    assert_eq!(status_of(&c, &base, "ma-long").await, "HIT");
+    assert_eq!(origin.load(Ordering::SeqCst), 3);
+
+    tokio::time::sleep(Duration::from_millis(2_600)).await;
+
+    // Header-less entry expired after ~2 s => refetched (not a HIT).
+    let after = status_of(&c, &base, "short").await;
+    assert_ne!(after, "HIT", "default TTL must have expired the header-less entry");
+    assert_eq!(origin.load(Ordering::SeqCst), 4, "expired header-less entry must be refetched");
+    // Origin-supplied max-age wins over the default: still a HIT, no extra origin fetch.
+    assert_eq!(status_of(&c, &base, "ma-long").await, "HIT");
+    assert_eq!(origin.load(Ordering::SeqCst), 4);
+}
+
+fn resolve_with(pairs: &[(&str, &str)]) -> Result<Config, Vec<ConfigError>> {
+    resolve(&Inputs {
+        env: pairs.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect(),
+        ..Default::default()
+    })
+}
+
+#[test]
+fn default_ttl_key_is_applied_by_main_and_range_validated() {
+    assert_eq!(spec("PHANTOM_DEFAULT_TTL_MS").unwrap().wiring, Wiring::Main);
+    assert_eq!(spec("PHANTOM_DEFAULT_TTL_MS").unwrap().default, Some("60000"));
+    assert_eq!(resolve_with(&[]).unwrap().get_u64("PHANTOM_DEFAULT_TTL_MS"), 60_000);
+    for good in ["1", "5000", "31536000000"] {
+        let c = resolve_with(&[("PHANTOM_DEFAULT_TTL_MS", good)]).unwrap_or_else(|e| panic!("{good}: {e:?}"));
+        assert_eq!(c.get_u64("PHANTOM_DEFAULT_TTL_MS").to_string(), good);
+        assert!(c.warnings.iter().all(|w| !w.contains("not honored")), "no not-honored warning for {good}");
+    }
+    for bad in ["0", "-1", "abc", "", "1.5", "31536000001", "60s"] {
+        // An empty value counts as "not set" (documented), so it resolves to the default.
+        if bad.is_empty() {
+            assert_eq!(resolve_with(&[("PHANTOM_DEFAULT_TTL_MS", bad)]).unwrap().get_u64("PHANTOM_DEFAULT_TTL_MS"), 60_000);
+            continue;
+        }
+        let e = resolve_with(&[("PHANTOM_DEFAULT_TTL_MS", bad)]).expect_err(bad);
+        assert!(e.iter().any(|x| x.key.as_deref() == Some("PHANTOM_DEFAULT_TTL_MS")), "{bad}: {e:?}");
+    }
+}
