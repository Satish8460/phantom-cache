     pub router: Option<Arc<crate::dist::router::RendezvousRouter>>,
 }
 
+/// Fallback freshness lifetime (ms) for cacheable 200 responses that carry no origin freshness
+/// information. Matches the historical literal and `PHANTOM_DEFAULT_TTL_MS`'s schema default.
+pub const DEFAULT_TTL_MS_FALLBACK: u64 = 60_000;
+
+/// Process-wide default TTL, set once at startup by `main` from `PHANTOM_DEFAULT_TTL_MS`
+/// (same pattern as the intelligence executor global; avoids changing the `ApiState` literal
+/// that dozens of tests construct). Read per origin fill with a relaxed load.
+static DEFAULT_TTL_MS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(DEFAULT_TTL_MS_FALLBACK);
+
+/// Set the default freshness lifetime used when the origin sends none (0 is ignored: the config
+/// layer rejects it, and a zero default would silently disable caching of header-less responses).
+pub fn set_default_ttl_ms(ms: u64) {
+    if ms > 0 {
+        DEFAULT_TTL_MS.store(ms, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+/// Current default freshness lifetime in milliseconds.
+pub fn default_ttl_ms() -> u64 {
+    DEFAULT_TTL_MS.load(std::sync::atomic::Ordering::Relaxed)
+}
