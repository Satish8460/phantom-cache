+
+pub fn calculate_resource_bytes(resource: Option<&CachedResource>) -> usize {
+    match resource {
+        Some(res) => {
+            res.body.capacity() + res.content_type.len() + res.etag.as_ref().map_or(0, |e| e.len())
+        }
+        None => 0,
+    }
+}
